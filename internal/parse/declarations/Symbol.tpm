# ABOUTME: Declares what `use Symbol` exports: gensym, ungensym, qualify, qualify_to_ref bare,
# ABOUTME: delete_package and geniosym by request. Measured on perl 5.42.0 with Symbol 1.09.
package Symbol;

# gensym returns a reference to a fresh anonymous glob, always: measured
# on 5.42.0, prototype() reports "".
sub gensym :export () GlobRef;
# ungensym's body is empty, so it returns nothing, as a bare `return`
# does: measured on 5.42.0, prototype() reports "$".
sub ungensym :export (Any $sym) Void;
# qualify returns the argument unchanged when it is a reference ("References
# are left unchanged under the assumption that they are glob references",
# per its docs), and the qualified name as a Str otherwise: measured on
# 5.42.0, qualify(\*STDOUT) returns that same GlobRef, and qualify("x")
# "main::x". Declared by argument type, RFC 0001 "Multi declarations", so a
# caller already holding a Ref -- IO::Handle's `qualify($_[0], caller) if
# ref($_[0])` -- keeps a Ref rather than Str|GlobRef. Prototype is "$;$".
# The Ref candidate's own return is narrower than its docs' "assumption":
# measured, `ref qualify({})` is HASH and `ref qualify([])` is ARRAY, not
# GlobRef -- the reference comes back exactly as given, so the candidate
# returns Ref, not GlobRef. IO/Handle.pm's own `tell qualify($_[0],
# caller) if ref($_[0])` makes tell's own Glob-only parameter see a Ref
# psc cannot narrow further, though it is in fact always a GlobRef there
# -- a possible mismatch under perigrin's ruling (2026-10-21, RFC 0001,
# "Possible mismatch beside a fitting member"), silent by default and
# reported only under --warn-possible-mismatch. The Str candidate's own
# coverage stays as declared: measured, `qualify(true)` is 'main::1' and
# `qualify(*STDOUT)` is '\*main::STDOUT', but both are perl stringifying
# the argument the same way every other Str parameter in this file is,
# not a value Str has no coercion for (RFC 0001, "What a parameter type
# means"); `qualify(undef)` is 'main::' with an uninitialized warning,
# left out deliberately.
multi sub qualify :export (Ref $name, Optional[Str] $pkg) Ref;
multi sub qualify :export (Str $name, Optional[Str] $pkg) Str;
# qualify_to_ref always returns a glob reference, whichever shape its name
# argument is: measured on 5.42.0, qualify_to_ref(\*STDOUT) returns that
# same GlobRef, and qualify_to_ref("x") a fresh one. One signature covers
# both, its parameter widened to the two shapes qualify's docs describe,
# since the return does not fork on which was given. Prototype is "$;$".
# Ref was too wide: measured, qualify_to_ref({}), qualify_to_ref(\"x")
# and qualify_to_ref(sub{}) all die "Not a GLOB reference" -- values Ref
# admits that perl has no coercion for and dies on, narrowed to GlobRef.
# Object is added: a blessed reference whose underlying referent is a
# glob (IO::Handle and the like) is accepted and preserved unchanged
# (measured, `ref qualify_to_ref(IO::Handle->new)` is IO::Handle, not
# GlobRef), the return widened to match.
sub qualify_to_ref :export (Str|GlobRef|Object $name, Optional[Str] $pkg) GlobRef|Object;
# delete_package answers scalar context only (it never returns an Array
# or Hash), so the oracle never calls it in list context, where measured
# on 5.42.0 a `return;` with no package found yields the empty list:
# only its scalar reads need stating. A package found and deleted
# returns the bare glob `delete` took out of the parent stash, which
# observe_types.pl's ref-based test reports as Str, not a GlobRef (no
# reference was ever taken of it); a package not found returns undef.
# Prototype is "$". Str stays rather than Glob: the same observer
# limitation Scalar/Util.tpm's openhandle comment notes (ref() of a
# bare Glob is always "", indistinguishable here from a plain string),
# so Str is what this measurement methodology can state, not the
# declaration's full nature; left as recorded, not reopened here.
sub delete_package :export_ok (Str $pkg) Str|Undef;
# geniosym forces the IO slot of a fresh anonymous glob and returns it,
# always blessed: measured on 5.42.0, prototype() reports "".
sub geniosym :export_ok () Object;
