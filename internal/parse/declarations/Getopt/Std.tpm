# ABOUTME: Declares what `use Getopt::Std` exports: getopt and getopts, both bare.
# ABOUTME: Measured on perl 5.42.0 with Getopt::Std 1.14: prototypes (;$$) and ($;$).
package Getopt::Std;

# getopt falls off its end, through `Getopt::Std->import` when $hash is
# not a reference, or through the empty `unless` block when it is:
# measured on 5.42.0, both leave a Boolean in either context. $hash is
# Any, not Optional[Any]: Any is the permissive top and an Optional of
# it still requires the argument (RFC 0001, "Any is the permissive
# top... not a union that happens to hold Void"), so its own default is
# what leaves it optional.
sub getopt :export (Optional[Str] $switches, Any $hash = undef) Boolean;
# getopts ends `$errs == 0`, a Boolean: true unless an unrecognised
# switch was seen (measured on 5.42.0, an unknown option still leaves a
# Boolean, just a false one).
sub getopts :export (Str $switches, Any $hash = undef) Boolean;
