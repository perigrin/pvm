# ABOUTME: Declares what `use Getopt::Long` installs: GetOptions and the three order
# ABOUTME: variables bare, the rest by name. Measured on perl 5.42.0 with Getopt::Long 2.58.

package Getopt::Long;

# Measured on 5.42.0: a bare `use Getopt::Long;` installs GetOptions and
# these three; Configure, HelpMessage, VersionMessage,
# GetOptionsFromArray and GetOptionsFromString are in @EXPORT_OK alone.
our Int $REQUIRE_ORDER :export;
our Int $PERMUTE :export;
our Int $RETURN_IN_ORDER :export;

# GetOptions and GetOptionsFromArray leave a Boolean, true unless an
# option failed to parse (measured: an unknown option still leaves a
# Boolean, just a false one, with a warning).
sub GetOptions :export :prototype(@) (List @args) Boolean;
sub GetOptionsFromArray :export_ok :prototype(@) (List @args) Boolean;
# GetOptionsFromString leaves the same Boolean in scalar context; in
# list context it also returns the leftover unparsed tokens as an
# ArrayRef (measured).
multi sub GetOptionsFromString :export_ok :prototype(@) (List @args) Boolean;
multi sub GetOptionsFromString :export_ok :prototype(@) (List @args) List[Boolean|ArrayRef];

# Configure leaves an ArrayRef of the configuration it replaced (measured:
# 17 elements); an unrecognised option name dies (measured), as CORE's
# die does.
sub Configure :export_ok :prototype(@) (List @args) ArrayRef;

# HelpMessage and VersionMessage end the process: each calls CORE::exit
# unless called with `-exitval => "NOEXIT"`, the POD's own documented
# escape ("or else the string NOEXIT to indicate that control should
# simply be returned without terminating the invoking process").
# Measured on 5.42.0: VersionMessage(-exitval => "NOEXIT", -message =>
# "m") is a true Boolean (builtin::is_bool), not None -- its last
# statement is the skipped `unless` condition, itself a Boolean;
# HelpMessage's last statement, pod2usage(...), answers the same way
# under the same option. Declared None, psc would mark any code after a
# documented NOEXIT call unreachable. Held to prototype and exports
# only in the general oracle (oracleExempt), since calling either with
# its usual, exiting invocation would end that perl process before it
# reports; testdata/oracle/Getopt-Long-noexit.pl holds the NOEXIT form
# in its own isolated run.
sub HelpMessage :export_ok :prototype(@) (List @args) Boolean;
sub VersionMessage :export_ok :prototype(@) (List @args) Boolean;
