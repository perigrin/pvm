# ABOUTME: Declares what `use Test::More` installs: every testing sub, bare, plus $TODO.
# ABOUTME: Measured on perl 5.42.0 with Test::More 1.302210.

package Test::More;

# Test::More's import is Test::Builder::Module's (measured: its own
# source `use`s it). The parameters are the signature to import()
# (perigrin's ruling, 2026-10-20): declaring it here states that a
# `use Test::More` list is import's argument list, not export names,
# so `use Test::More tests => 3;` installs the same names a bare
# `use` does (measured), and every name below is :export. $class is
# the invocant (Test::More->import(@plan)), so the colon keeps the
# derived prototype none, matching perl's (prototype() on the
# inherited Test::Builder::Module::import is undef).
#
# The signature names the keys (perigrin's ruling, 2026-10-20): $import
# is the one key (`import => [...]`, Test::Builder::Module's own, not an
# export list) whose presence changes what import installs -- measured
# on 5.42.0, `use Test::More import => ['ok'], tests => 1;` installs
# only ok, never the full set below, so a use-list carrying this key
# claims no names and leaves the symbols open; one without it installs
# the names below, as a bare use does. The key's parameter is typed
# ArrayRef, not Str: measured on 5.42.0,
# Test::Builder::Module::_strip_imports dereferences the value paired
# with the import key as an array (`@{ $list->[$idx+1] }`), so the
# value, not only the key, is part of what perl passes there.
sub import (Str $class: ArrayRef $import = undef, List @plan) Void;
our Str|Undef $TODO :export;

# BAIL_OUT exits the whole test run: measured on 5.42.0, it calls
# CORE::exit directly from Test::Builder's bail_out, bypassing the
# return-type oracle's CORE::GLOBAL::exit override the same way
# POSIX::exit does, so calling it would end the oracle's own perl
# process. Declared None, as exit is in CORE.tpm; held to prototype and
# exports only (oracleExempt).
sub BAIL_OUT :export (List @args) None;

# Every assertion below ends `return 1;` or `return 0;`, a plain Int,
# not perl's own boolean (measured with builtin::is_bool: none of
# these calls' results carries the boolean flag a comparison or
# negation does).
sub can_ok :export :prototype($@) (Any $thing, List @methods) Int;
sub cmp_ok :export :prototype($$$;$) (Any $got, Str $op, Any $expected, Str $name = undef) Int;
sub diag :export (List @args) Int;
sub done_testing :export (List @args) Int;
sub eq_array :export (List @args) Int;
sub eq_hash :export (List @args) Int;
sub eq_set :export (List @args) Int;
# explain formats each argument as a string, measured on 5.42.0: one
# per argument in list context; a real array variable, so scalar
# context gives their count.
multi sub explain :export (List @args) List[Str];
multi sub explain :export (List @args) Int;
sub fail :export :prototype(;$) (Str $name = undef) Int;
sub is :export :prototype($$;$) (Any $got, Any $expected, Str $name = undef) Int;
sub is_deeply :export (List @args) Int;
sub isa_ok :export :prototype($$;$) (Any $thing, Str $class, Str $name = undef) Int;
sub isnt :export :prototype($$;$) (Any $got, Any $expected, Str $name = undef) Int;
sub like :export :prototype($$;$) (Any $got, Any $pattern, Str $name = undef) Int;
# new_ok's own final statement, `return $obj`, holds whatever $class->new
# returned (measured: a class whose new returns undef, as new_ok's own
# error path does nothing to replace, leaves new_ok undef too).
sub new_ok :export (List @args) Object|Undef;
sub note :export (List @args) Int;
sub ok :export :prototype($;$) (Any $test, Str $name = undef) Int;
sub pass :export :prototype(;$) (Str $name = undef) Int;
# plan dies "You tried to plan twice" once any plan already exists
# (measured) -- including one done_testing sets, which the oracle's own
# alphabetically earlier call to done_testing always leaves in place --
# so the oracle cannot call plan without that collision. Held to
# prototype and exports only (oracleExempt).
sub plan :export (List @args) Int;
sub require_ok :export :prototype($) (Str $module) Int;
# skip and todo_skip never return a value to their caller: measured on
# 5.42.0, each ends in `last SKIP` / `last TODO` inside the block that
# name, and called with no such block in scope -- as the oracle calls
# it -- each dies "Label not found", which None permits.
sub skip :export (List @args) None;
sub subtest :export (List @args) Int;
sub todo_skip :export (List @args) None;
sub unlike :export :prototype($$;$) (Any $got, Any $pattern, Str $name = undef) Int;
sub use_ok :export :prototype($;@) (Str $module, List @imports) Int;
