# ABOUTME: Declares what `use File::Temp` installs: the POSIX, mktemp and seekable tags bare, the rest on request.
# ABOUTME: Measured on perl 5.42.0 with File::Temp 0.2311: tempfile, tempdir, unlink0 and cleanup are export_ok only.
package File::Temp;

# File::Temp.pm calls Exporter::export_tags('POSIX','mktemp','seekable')
# to add those three tags' names to @EXPORT; tempfile, tempdir, unlink0
# and cleanup stay export_ok, measured on 5.42.0: a bare `use File::Temp;`
# installs none of the four.
sub SEEK_SET :export(seekable) () Int;
sub SEEK_CUR :export(seekable) () Int;
sub SEEK_END :export(seekable) () Int;

# mkstemp and mkstemps return (filehandle, filename) in list context,
# just the filehandle in scalar context; both croak on error. Measured
# on 5.42.0.
multi sub mkstemp :export(mktemp) :listop (Str $template) List[GlobRef|Str];
multi sub mkstemp :export(mktemp) :listop (Str $template) GlobRef;
multi sub mkstemps :export(mktemp) :listop (Str $template, Str $suffix) List[GlobRef|Str];
multi sub mkstemps :export(mktemp) :listop (Str $template, Str $suffix) GlobRef;
sub mkdtemp :export(mktemp) :listop (Str $template) Str;
sub mktemp :export(mktemp) :listop (Str $template) Str;

# tmpnam returns the filename alone in scalar context, and
# (filehandle, filename) in list context, by calling mkstemp()
# internally. Measured on 5.42.0.
multi sub tmpnam :export(POSIX) :listop () Str;
multi sub tmpnam :export(POSIX) :listop () List[GlobRef|Str];
# tmpfile's underlying mkstemp can fail, and tmpfile itself ends
# `unlink0($fh, $file) or return undef;`, so Undef joins GlobRef
# (audit-C.md finding 16).
sub tmpfile :export(POSIX) :listop () GlobRef|Undef;

# tempfile and tempdir take a template and/or named options in either
# order (TEMPLATE, OPTIONS, or OPTIONS alone); tempfile returns
# (filehandle, filename) in list context and just the filehandle in
# scalar context, measured on 5.42.0. Neither is exported bare.
multi sub tempfile :export_ok (List @args) List[GlobRef|Str];
multi sub tempfile :export_ok (List @args) GlobRef;
sub tempdir :export_ok (List @args) Str;

# unlink0 unlinks an open file after checking the handle and the name
# point to the same file; it returns false on error and may croak on a
# security anomaly. Measured on 5.42.0. It only stat()s the handle, so
# it works on a bareword Glob or a blessed File::Temp object too, not
# only the GlobRef `open my $fh` gives (measured: unlink0($file_temp_obj,
# $obj->filename) returns 1; audit-C.md finding 17).
sub unlink0 :export_ok :listop (FileHandle|Object $fh, Str $path) Int;
# cleanup removes every temp file and directory File::Temp has
# registered; its return value is undocumented and not meant to be
# read, measured on 5.42.0 to be an internal bookkeeping value.
sub cleanup :export_ok :listop () Any;

# tempnam, cmpstat and unlink1 are documented ("ADDITIONAL FUNCTIONS",
# "UTILITY FUNCTIONS") but not exported under any tag; callers reach
# each only as File::Temp::name(...). Measured on 5.42.0 (audit-C.md
# finding 15). None of the three is written with a prototype (measured
# none), so each is :listop, as other plain library functions with
# typed positional parameters and no real prototype are (e.g.
# File::Spec::Functions.tpm's canonpath).
sub tempnam :listop (Str $dir, Str $prefix) Str;
sub cmpstat :listop (FileHandle $fh, Str $path) Int;
sub unlink1 :listop (FileHandle $fh, Str $path) Int;

# The OO interface (POD "OBJECT-ORIENTED INTERFACE"), omitted entirely
# before this fix (audit-C.md finding 14). filename and
# unlink_on_destroy are instance methods; safe_level and
# top_system_uid are class methods that are also plain subs
# (File::Temp::safe_level()), measured to answer the same way either
# form is called. newdir's POD return, File::Temp::Dir, has no
# declaration of its own (one package per file; File::Temp::Dir is not
# in the ranked top-50 modules this project's declarations cover), so
# it is left the generic Object every other constructor here answers.
sub new (Str $class: List @args) Object;
sub newdir (Str $class: List @args) Object;
sub filename (Object $self:) Str;
# unlink_on_destroy both gets and sets a plain Int flag (measured 1/0;
# is_bool false of it, unlike a marked Boolean).
sub unlink_on_destroy (Object $self: Optional[Boolean] $on) Int;
sub safe_level (Str $class: Optional[Int] $level) Int;
sub top_system_uid (Str $class: Optional[Int] $uid) Int;
