# ABOUTME: Declares what `use File::Basename` exports: fileparse, basename, dirname, fileparse_set_fstype.
# ABOUTME: Measured on perl 5.42.0 with File::Basename 2.86: none of its subs carry a prototype.
package File::Basename;

# None of these four carries a prototype, so each takes a plain slurpy
# list, or states its leading scalar with :listop: a scalar before the
# list would otherwise derive a prototype perl does not report (RFC 0001,
# "No prototype is the default prototype").
#
# fileparse requires a defined path (it croaks otherwise, measured on
# 5.42.0), so Str excludes the Undef that would die. In list context it
# returns (basename, dirpath, suffix), each always a string -- the suffix
# defaults to '' when no @suffixes match. In scalar context it returns
# only the basename. The suffixes past the path are matched as
# patterns, not plain strings -- the POD gives `fileparse($path,
# qr/\.[^.]*/)` as a documented form, and measured on 5.42.0, that call
# matches the suffix exactly as the string '.txt' does -- so @args
# admits a Regex, preserved as a pattern rather than lossily stringified.
# The path is required -- measured, `fileparse()` dies "need a valid
# pathname" -- so it is its own parameter, and :listop states it with no
# prototype. Any reference there is stringified: measured, perl -w is
# silent on `fileparse({})` and on `fileparse("/a/b.c", {})`.
multi sub fileparse :export :listop (Str $path, List[Str|Regex] @suffixes) List[Str];
multi sub fileparse :export :listop (Str $path, List[Str|Regex] @suffixes) Str;
# basename and dirname always answer scalar context: measured on 5.42.0,
# a Windows path like 'C:\dir\f.txt' parses as Unix on this platform (no
# fstype set to MSWin32), so both still return a plain Str, just one with
# no directory split out of it.
sub basename :export (List[Str] @args) Str;
sub dirname :export (List[Str] @args) Str;
# fileparse_set_fstype returns the previous fstype, always a Str: the
# module's own load sets it from $^O before any caller can reach this
# sub, measured on 5.42.0 (`fileparse_set_fstype()` right after `use`
# already answers "Unix", never undef).
sub fileparse_set_fstype :export (List[Str] @args) Str;
