# ABOUTME: Declares what `use Moose::Role` defines in its caller, which Moose::Exporter builds out of sight.
# ABOUTME: Measured on perl 5.42.0 with Moose 2.4000: only blessed carries a prototype.
package Moose::Role;

our @EXPORT = qw(
    with requires excludes has before after around override
    extends super inner augment confess blessed meta
);

sub with;
sub requires;
sub excludes;
sub has;
sub before;
sub after;
sub around;
sub override;
sub extends;
sub super;
sub inner;
sub augment;
sub confess;
sub blessed :prototype($);
sub meta;
