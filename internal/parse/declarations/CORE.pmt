# ABOUTME: Declares perl's builtins: each keyword with a prototype, as perl 5.42.0 reports it.
# ABOUTME: Parsed to build the default builtin table; types are to be added to these lines.
#
# Generated over every keyword in regen/keywords.pl (the lexer's perlKeywords)
# with
#
#   perl -e 'while (my $k = <STDIN>) { chomp $k;
#       my $p = eval { prototype("CORE::$k") };
#       print "sub $k :prototype($p);\n" if defined $p }'
#
# A keyword missing here has no prototype perl can report: it is not a
# function (`if`, `my`) or its parse is its own (`sort`). The builtins whose
# leading slot takes no comma, `print` among them, are typed after the
# prototyped ones.
#
# A typed line carries its prototype in its types and writes none (RFC 0001,
# "A typed signature and a prototype say the same thing"): `bless`'s
# `(Ref $ref, Str $class = __PACKAGE__)` derives `$;$`. One whose types
# derive `@` writes `:prototype(@)`, since a derived `@` is no prototype.
package CORE;

sub __CLASS__ :prototype();
sub __FILE__ :prototype();
sub __LINE__ :prototype();
sub __PACKAGE__ :prototype();
sub __SUB__ :prototype();
# Numeric transforms. abs follows its argument and int always truncates to
# an integer; both are narrowed further by inference, which a signature
# cannot express. With no argument each takes `$_`: `abs()` compiles
# (measured).
sub abs (Num $number = $_) Num;
sub accept :prototype(**);
sub alarm :prototype(_);
# all and any take a block and then a LIST, which may be empty: `all {1} ()`
# is true, and `all()` is "Not enough arguments" (measured). The block is a
# literal block; `all sub {1}, 1` is a syntax error. Each returns a boolean
# in every context, one value even in list context (measured: builtin's
# is_bool is true of both results).
sub all (Code \&block, List @list) Boolean;
# Measured as all, above.
sub any (Code \&block, List @list) Boolean;
# atan2 takes both its arguments, y then x: `atan2(1)` is "Not enough
# arguments". Its result is a float, NOK even where it is whole: atan2(0, 1)
# is 0 as an NV (measured with B::svref_2object).
sub atan2 (Num $y, Num $x) Num;
sub bind :prototype(*$);
# binmode sets a handle's layers, :raw with none (measured: on a :crlf
# handle `binmode $fh` and `binmode $fh, ":raw"` leave the same layers),
# and yields true, or undef for a closed handle.
sub binmode (Glob *fh, Str $layer = ":raw") Boolean|Undef;
sub bless (Ref $ref, Str $class = __PACKAGE__) Object;
sub break :prototype();
sub caller :prototype(;$);
sub catch :prototype();
# chdir changes to a directory named by a string or held by a handle
# (measured: `chdir DH` and `chdir($dh)` change into an opened directory).
# With none it takes $ENV{HOME} when that exists, even empty, and
# $ENV{LOGDIR} otherwise; with neither it fails, as chdir(undef) does
# (measured). It yields true or false.
sub chdir (Str|FileHandle $dir = exists $ENV{HOME} ? $ENV{HOME} : $ENV{LOGDIR}) Boolean;
# chmod, chown and utime take a LIST that leads with the mode, the owner
# and group, or the times, and then the files, which a `@` prototype does
# not tell apart: `chmod()` compiles (measured). Each yields how many files
# it changed: chmod(0644, "f", "nope") is 1 as an IV.
sub chmod :prototype(@) (List @list) Int;
# Measured as chmod, above.
sub chown :prototype(@) (List @list) Int;
sub chr (Int $code = $_) Str;
# chroot takes a directory, `$_` with none, and yields 1 or 0 as an IV
# (measured: a missing directory is 0), as link, mkdir, rename, rmdir and
# symlink do: a count of one, not one of perl's booleans.
sub chroot (Str $dir = $_) Int;
# close and write take the selected handle with none (measured: `select
# $h; close` closes $h), and yield true or false: closing a closed handle
# is false, not undef. write dies for a handle with no format.
sub close (Glob *fh = select()) Boolean;
# closedir, rewinddir and seekdir yield true, or undef for a closed
# dirhandle (measured).
sub closedir (Glob *dh) Boolean|Undef;
sub connect :prototype(*$);
sub continue :prototype();
# cos, exp, log, sin and sqrt each take a number, `$_` with none (measured:
# `$_ = 0; cos()` is 1), and yield a float, NOK even where it is whole:
# cos(0) is 1 as an NV. log of a number not above zero and sqrt of a
# negative one die.
sub cos (Num $number = $_) Num;
# crypt takes the plaintext and the salt, both: `crypt("a")` is "Not enough
# arguments". It yields the digest, or "*0" for a salt it cannot use
# (measured: crypt("pw", "ab") is "abzlUXK5ed5rs", crypt("pw", "!") "*0").
sub crypt (Str $plaintext, Str $salt) Str;
# dbmclose unties the hash and yields true, even for one never opened
# (measured).
sub dbmclose (Hash \%hash) Boolean;
# dbmopen ties the hash to a database and yields the tied object, an
# AnyDBM_File, or undef when it cannot open one (measured: a missing
# directory, or a mode of undef for a database that does not exist).
sub dbmopen (Hash \%hash, Str $dbname, Int $mode) Object|Undef;
# die and warn take a LIST of strings, which may be empty: `die()` and
# `warn()` compile (measured). die never returns; warn returns true.
sub die :prototype(@) (List[Str] @message) None;
sub dump :prototype();
sub each :prototype(\[%@]);
sub endgrent :prototype();
sub endhostent :prototype();
sub endnetent :prototype();
sub endprotoent :prototype();
sub endpwent :prototype();
sub endservent :prototype();
# eof and tell take the last handle read with none, ${^LAST_FH} (measured:
# after reading B, `eof` and `tell` answer for B, not for A read before
# it). `eof()` with empty parentheses is another builtin, the end of the
# ARGV files, which a signature cannot tell from `eof`. eof yields a
# boolean; tell the position, -1 for a closed handle.
sub eof (Glob *fh = ${^LAST_FH}) Boolean;
sub evalbytes :prototype(_);
sub exit :prototype(;$);
# Measured as cos, above.
sub exp (Num $number = $_) Num;
# fc casefolds a string, `$_` with none (measured: `$_ = "XY"; CORE::fc()`
# is "xy"). It is a builtin only under the fc feature or spelled CORE::fc;
# the line types the builtin, whatever reads the word.
sub fc (Str $string = $_) Str;
# fcntl and ioctl yield the call's result, 0 being the string "0 but true",
# and undef on error (measured: F_GETFD of a close-on-exec handle is 1 as
# an IV, of another "0 but true" as a PV, of a closed handle undef). The
# third argument is the call's integer or a buffer it writes into.
sub fcntl (Glob *fh, Int $function, Scalar $argument) Str|Undef;
# fileno yields the descriptor, -1 for an in-memory handle, and undef for
# a closed one (measured).
sub fileno (Glob *fh) Int|Undef;
# flock yields 1 or 0 as an IV (measured: locking a closed handle is 0).
sub flock (Glob *fh, Int $operation) Int;
sub fork :prototype();
sub formline :prototype($@);
# getc reads one character, from STDIN with none (measured: with a file
# argument and "Z" piped in, `getc` is "Z"), and yields undef at end of
# file or for a closed handle.
sub getc (Glob *fh = *STDIN) Str|Undef;
sub getgrent :prototype();
sub getgrgid :prototype($);
sub getgrnam :prototype($);
sub gethostbyaddr :prototype($$);
sub gethostbyname :prototype($);
sub gethostent :prototype();
sub getlogin :prototype();
sub getnetbyaddr :prototype($$);
sub getnetbyname :prototype($);
sub getnetent :prototype();
sub getpeername :prototype(*);
sub getpgrp :prototype(;$);
sub getppid :prototype();
sub getpriority :prototype($$);
sub getprotobyname :prototype($);
sub getprotobynumber :prototype($;);
sub getprotoent :prototype();
sub getpwent :prototype();
sub getpwnam :prototype($);
sub getpwuid :prototype($);
sub getservbyname :prototype($$);
sub getservbyport :prototype($$);
sub getservent :prototype();
sub getsockname :prototype(*);
sub getsockopt :prototype(*$$);
# glob expands a pattern, `$_` with none: in list context every match, in
# scalar context the next one, undef past the last -- one of the list's
# values, so List covers both. `_;` keeps its `;`, which no type states.
sub glob :prototype(_;) (Str $pattern = $_) List;
sub gmtime :prototype(;$);
# hex and oct read a string of digits, `$_` with none, and yield its
# integer: hex("ff") is 255 as an IV, hex("zz") 0, oct("755") 493. oct
# reads a 0x, 0b or 0o prefix, hex only 0x. Past an IV the integer is
# an NV, with an overflow warning: hex("ffffffffffffffffff") is
# 4.72236648286965e+21 -- whole still, as int's is (measured).
sub hex (Str $string = $_) Int;
# index and rindex search a string for a substring and yield a position,
# or -1 when absent -- an Int either way. The position defaults to the
# start for index and the end for rindex (measured: `rindex($s, "b")` and
# `rindex($s, "b", length($s))` agree).
sub index (Str $string, Str $substring, Int $position = 0) Int;
# Measured as abs, above.
sub int (Num $number = $_) Int;
# Measured as fcntl, above.
sub ioctl (Glob *fh, Int $function, Scalar $argument) Str|Undef;
sub isa :prototype();
# join takes a separator and then a LIST, not a series of strings: Str
# there rejected `join ":", @foo`. Measured: join(":", @f) flattens the
# array, and `join(":")` compiles, with an empty list.
sub join (Str $separator, List @list) Str;
# keys takes one hash or array, never a scalar or a list: `keys $ref` is
# "Experimental keys on scalar is now forbidden", and `keys;` "Not enough
# arguments" (measured). Its scalar-context value is a count -- with two
# keys, `my $n = keys %h` is 2, and with three elements, `my $m = keys @a`
# is 3, each IOK only -- which is not one of the list-context values.
multi sub keys :context($) (Hash \%h) Int;
multi sub keys :context($) (Array \@a) Int;
multi sub keys :context(@) (Hash \%h) List;
multi sub keys :context(@) (Array \@a) List;
sub kill :prototype(@);
# Measured as uc, below.
sub lc (Str $string = $_) Str;
# Measured as uc, below.
sub lcfirst (Str $string = $_) Str;
sub length (Str $string = $_) Int;
# Measured as chroot, above: link("nope", "h") is 0 as an IV.
sub link (Str $old, Str $new) Int;
sub listen :prototype(*$);
sub localtime :prototype(;$);
sub lock :prototype(\[$@%&*]);
# Measured as cos, above.
sub log (Num $number = $_) Num;
# lstat and stat take a file name, a handle or a dirhandle, `$_` with none
# (measured: `stat` and `stat STDIN` each give 13 fields). In list context
# the 13 fields, or none when the file is missing; in scalar context
# whether it succeeded, a boolean -- not one of the fields, so two
# candidates.
multi sub lstat :context(@) (Glob *file = $_) List;
multi sub lstat :context($) (Glob *file = $_) Boolean;
sub method :prototype();
# mkdir takes a directory, `$_` with none, and a mode, 0777 with none
# (measured under umask 0: a directory made without a mode is 0777).
# Measured as chroot, above: mkdir of an existing directory is 0 as an IV.
sub mkdir (Str $dir = $_, Int $mode = 0777) Int;
sub msgctl :prototype($$$);
sub msgget :prototype($$);
sub msgrcv :prototype($$$$$);
sub msgsnd :prototype($$$);
sub not :prototype($;);
# Measured as hex, above.
sub oct (Str $string = $_) Int;
# open takes a handle and then a mode and a LIST: a mode with the file
# name in it, or a mode followed by a file name, or by a command and its
# arguments. With neither, the one-argument form, the file name is the
# package scalar of the handle's name, ${*$fh} (measured: `our $OF = "f";
# open(OF)` opens f). It yields 1, a piped open the child's pid, and undef
# on failure (measured).
sub open (Glob *fh, Str $mode = ${*$fh}, List @list) Int|Undef;
# opendir yields true, or undef on failure (measured: opening a missing
# directory is undef).
sub opendir (Glob *dh, Str $dir) Boolean|Undef;
sub ord (Str $string = $_) Int;
# pack takes a template and then the LIST of values it packs into one
# string: `pack()` is "Not enough arguments", `pack("A")` compiles.
sub pack (Str $template, List @list) Str;
sub pipe :prototype(**);
# pop and shift take the array whole, defaulting to `@_` in a sub and to
# `@ARGV` outside one (measured: `perl -e 'print pop' x y` prints y).
sub pop (Array \@array = @_) Scalar;
sub pos :prototype(;\[$*]);
sub prototype :prototype(_);
# push, unshift and splice take a LIST, not Any. Everything flattens into
# it -- measured, scalars, arrays, hashes and refs all append -- so List
# accepts every value Any did, while still excluding Code and Glob. Any is
# the annotation escape hatch and has no business standing in for an
# unexamined slot. Each returns the array's new length. `push(@a)` and
# `unshift(@a)` compile (measured), so the list may be empty; `push()` is
# "Not enough arguments".
sub push (Array \@array, List @list) Int;
# quotemeta backslashes a string's non-word characters, `$_` with none
# (measured: `$_ = "a+"; quotemeta` is "a\+").
sub quotemeta (Str $string = $_) Str;
# rand yields a float between 0 and its argument, which is 1 when it is 0
# or absent: after srand(7), rand(), rand(1) and rand(0) are the same
# number, and a negative argument gives a negative float (rand(-1) after
# srand(1) is -0.0416, measured).
sub rand (Num $max = 1) Num;
# read and sysread fill the caller's buffer from a handle and yield how many
# characters they read: 0 at end of file, undef on error (measured: reading
# a closed handle is undef). Without an offset the buffer is replaced from
# its start, as offset 0 does (measured: both leave "XYZWVU" as "ab").
# A `*` slot is `Glob *`: a bareword handle or any scalar (RFC 0001, "A
# typed signature and a prototype say the same thing"), here and below.
sub read (Glob *fh, Scalar \$buffer, Int $length, Int $offset = 0) Int|Undef;
# readdir yields every remaining entry in list context and the next one in
# scalar context, undef past the last -- one of the list's values, so
# List covers both. A closed dirhandle is undef (measured).
sub readdir (Glob *dh) List;
# readline reads from ARGV with none (measured: `readline` and
# `readline(*ARGV)` read the same lines), and yields every remaining line
# in list context and the next one in scalar context, undef at end of file
# -- one of the list's values, so List covers both.
sub readline (Glob *fh = *ARGV) List;
# readlink yields a link's target, `$_` with none, or undef for a file
# that is not a link (measured).
sub readlink (Str $path = $_) Str|Undef;
sub readpipe :prototype(_);
sub recv :prototype(*\$$$);
sub ref (Scalar $thing = $_) Str;
# Measured as chroot, above: rename("nope", "x") is 0 as an IV.
sub rename (Str $old, Str $new) Int;
sub reset :prototype(;$);
# reverse is context-dependent: a reversed list in list context, a
# reversed string in scalar context -- `my $s = reverse "ab", "cd"` is
# "dcba" (POK), not one of the list values ("cd", "ab"), so each context
# is its own candidate. `reverse()` compiles (measured).
multi sub reverse :prototype(@) :context($) (List @list) Str;
multi sub reverse :prototype(@) :context(@) (List @list) List;
# Measured as closedir, above.
sub rewinddir (Glob *dh) Boolean|Undef;
# Measured as index, above.
sub rindex (Str $string, Str $substring, Int $position = length($string)) Int;
# Measured as chroot, above: rmdir of a missing directory is 0 as an IV.
sub rmdir (Str $dir = $_) Int;
# scalar() imposes scalar context on anything: its argument is coerced to
# a Scalar, as a `$` prototype's is (measured: with `@a = (5, 6, 7)`,
# `scalar(@a)` is 3). The return type depends on the argument and is
# inference's to compute -- a signature can only name one type, and this
# builtin's answer is "whatever the argument becomes".
sub scalar (Scalar $expr) Scalar;
# seek yields true, or false for a closed handle (measured).
sub seek (Glob *fh, Int $position, Int $whence) Boolean;
# Measured as closedir, above.
sub seekdir (Glob *dh, Int $position) Boolean|Undef;
sub semctl :prototype($$$$);
sub semget :prototype($$$);
sub semop :prototype($$);
sub send :prototype(*$$;$);
sub setgrent :prototype();
sub sethostent :prototype($);
sub setnetent :prototype($);
sub setpgrp :prototype(;$$);
sub setpriority :prototype($$$);
sub setprotoent :prototype($);
sub setpwent :prototype();
sub setservent :prototype($);
sub setsockopt :prototype(*$$$);
# Measured as pop, above.
sub shift (Array \@array = @_) Scalar;
sub shmctl :prototype($$$);
sub shmget :prototype($$$);
sub shmread :prototype($$$$);
sub shmwrite :prototype($$$$);
sub shutdown :prototype(*$);
# Measured as cos, above.
sub sin (Num $number = $_) Num;
sub sleep :prototype(;$);
sub socket :prototype(*$$$);
sub socketpair :prototype(**$$$);
# splice takes the array whole, then a LIST as push does. With no length
# it removes to the end, as `scalar(@array)` does, a length past the end
# being clipped (measured: `splice(@a, 1)` and `splice(@a, 1, scalar(@a))`
# remove the same elements, from either end of the offset).
sub splice (Array \@array, Int $offset = 0, Int $length = scalar(@array), List @list) List;
# sprintf takes a format and then the LIST of values it interpolates.
sub sprintf (Str $format, List @list) Str;
# Measured as cos, above.
sub sqrt (Num $number = $_) Num;
# srand seeds rand and returns the seed, an integer (srand(5) is 5 as an
# IV, srand(3.7) 3) -- but seed 0 comes back as the string "0 but true",
# so the result is Str. With no argument perl "(semi-)randomly chooses a
# seed" (perlfunc), or takes PERL_RAND_SEED's; no expression states that
# choice, so the default names the call that makes it.
sub srand (Int $seed = srand()) Str;
# Measured as lstat, above.
multi sub stat :context(@) (Glob *file = $_) List;
multi sub stat :context($) (Glob *file = $_) Boolean;
# study is a no-op since 5.16 that still answers: true for a defined
# string, `$_` with none, and false for undef (measured: study("x") is 1,
# study(undef) "").
sub study (Str $string = $_) Boolean;
# substr's fourth argument is the string that replaces the part it
# returns: measured, `substr($s, 0, 1, 5)` makes "abc" "5bc". Without it
# nothing is replaced, as replacing the part with itself does -- except
# past the end of the string, where the 3-argument form warns and returns
# undef but the 4-argument form dies, "substr outside of string". Without
# a length it returns the rest of the string.
sub substr (Str $string, Num $offset, Num $length = length($string), Str $replacement = substr($string, $offset, $length)) Str;
# Measured as chroot, above: symlink to a name that exists is 0 as an IV.
sub symlink (Str $old, Str $new) Int;
# syscall takes the call's number and then the LIST of its arguments, which
# may be empty (`syscall(39)` compiles and is getpid), and yields the
# call's result, -1 on error (measured: an unknown number is -1).
sub syscall (Int $number, List @args) Int;
# sysopen takes a handle, a path and the O_ flags, and permissions, 0666
# with none (measured under umask 0: a file it creates is 0666). It yields
# true, or undef on failure.
sub sysopen (Glob *fh, Str $path, Int $mode, Int $perms = 0666) Boolean|Undef;
# Measured as read, above.
sub sysread (Glob *fh, Scalar \$buffer, Int $length, Int $offset = 0) Int|Undef;
# sysseek yields the new position, a position of 0 being the string
# "0 but true", and undef on error (measured: sysseek($fh, 3, 0) is 3 as
# an IV, sysseek($fh, 0, 0) "0 but true" as a PV, a closed handle undef).
sub sysseek (Glob *fh, Int $position, Int $whence) Str|Undef;
# syswrite writes the whole string from its start when given no length,
# as length($string) and offset 0 do (measured: both write 5 bytes of
# "hello"), and yields how many it wrote, undef on error.
sub syswrite (Glob *fh, Str $string, Int $length = length($string), Int $offset = 0) Int|Undef;
# Measured as eof, above.
sub tell (Glob *fh = ${^LAST_FH}) Int;
# telldir yields the position, undef for a closed dirhandle (measured).
sub telldir (Glob *dh) Int|Undef;
sub tie :prototype(\[$@%*]$@);
sub tied :prototype(\[$@%*]);
sub time :prototype();
sub times :prototype();
# truncate takes a handle or a file name, so its `$` slot is either
# (measured: `truncate F, 1` with F a bareword handle, and
# truncate("a", 1), both cut the file), and yields true, or undef on
# failure.
sub truncate (Str|FileHandle $file, Int $length) Boolean|Undef;
# String transforms. Each takes a string and yields one; return types
# measured on 5.42 rather than transcribed. With no argument each takes
# `$_`: `uc()` compiles (measured).
sub uc (Str $string = $_) Str;
# Measured as uc, above.
sub ucfirst (Str $string = $_) Str;
# umask sets the mask and yields the one before it. With no argument it
# sets nothing, which umask(umask()) also does -- it yields the current
# mask and sets it again (measured: after umask 027, umask() and
# umask(umask()) are both 23) -- while umask(undef) sets 0. No other
# expression states that default, so it names the call, as srand's does.
sub umask (Int $mask = umask()) Int;
sub undef :prototype(;\[$@%&*]);
# unlink deletes the files of a LIST, `$_` with none (measured: `$_ =
# "f2"; unlink` deletes f2), and yields how many it deleted.
sub unlink :prototype(@) (List[Str] @files = ($_)) Int;
# unpack takes a template and a string, defaulting to `$_`: `unpack("A1
# A1")` unpacks `$_`, `unpack()` is "Not enough arguments", and a third
# argument "Too many" (measured). In scalar context it returns the first
# value the list would hold (`unpack("A1 A1", "ab")` is "a"), so List covers
# both contexts, since Scalar <: List.
sub unpack (Str $template, Str $string = $_) List;
# Measured as push, above.
sub unshift (Array \@array, List @list) Int;
sub untie :prototype(\[$@%*]);
# Measured as chmod, above: utime(undef, undef, "f", "nope") is 1.
sub utime :prototype(@) (List @list) Int;
# Measured as keys, above.
multi sub values :context($) (Hash \%h) Int;
multi sub values :context($) (Array \@a) Int;
multi sub values :context(@) (Hash \%h) List;
multi sub values :context(@) (Array \@a) List;
# vec reads the unsigned integer of a width of bits at an offset in a
# string, all three required (`vec("a", 0)` does not compile): vec("abc",
# 0, 8) is 97 as an IV, and past the string's end 0 (measured).
sub vec (Str $string, Int $offset, Int $bits) Int;
sub wait :prototype();
sub waitpid :prototype($$);
sub wantarray :prototype();
# Measured as die, above.
sub warn :prototype(@) (List[Str] @message) Boolean;
# Measured as close, above: write to a closed handle is false.
sub write (Glob *fh = select()) Boolean;

# Builtins with a leading slot taken with no comma after it (RFC 0001,
# "Builtins that keep their own parse"), written with the invocant colon.
# They derive no prototype: measured on 5.42.0, `prototype("CORE::$_")` is
# undef for each.
#
# print, say and printf: the slot is a handle, `print STDERR LIST` or
# `print {$fh} LIST`, and the default is the selected one, not STDOUT
# (`select $h; print "x"` writes to $h). With no list each takes `$_`:
# `$_ = "topic"; print` prints "topic", and `print STDOUT` alone does too.
# printf's format is the list's first element, not a parameter of its own:
# `@a = ("<%s-%s>", "a", "b"); printf @a` prints "<a-b>", where sprintf's
# `$@` takes scalar(@a). Each returns 1, or undef when the write fails.
# Each returns a boolean when the write succeeds and undef when it fails:
# to a closed handle all three give undef (measured).
sub print (FileHandle $fh = select(): List[Str] @args = ($_)) Boolean|Undef;
sub printf (FileHandle $fh = select(): List @args = ($_)) Boolean|Undef;
sub say (FileHandle $fh = select(): List[Str] @args = ($_)) Boolean|Undef;

# exec and system: the slot is the program to run, `exec {'/bin/sh'} @args`
# or `system $shell "-sh"`, and with it the list may not be empty: `exec
# {"/bin/echo"};` is a syntax error. exec returns only on failure, false;
# system returns the wait status, `system "true"` 0, `system "false"` 256
# and a program that cannot run -1.
sub exec (Str $program: List[Str] @args) Boolean;
sub system (Str $program: List[Str] @args) Int;

# Operators (RFC 0001, "Operator declarations"): each under its symbol, with
# its fixity and, for an infix one, the class naming its precedence level in
# the parser's table. The types are upper bounds: `Int + Int` is an Int within
# `Num`, and narrowing it is inference's. An operator that forks on context or
# on a parenthesis is a multi, one candidate for each branch.

# Arithmetic
sub + :infix(ADD) (Num $x, Num $y) Num;
sub - :infix(ADD) (Num $x, Num $y) Num;
sub * :infix(MUL) (Num $x, Num $y) Num;
sub / :infix(MUL) (Num $x, Num $y) Num;
sub % :infix(MUL) (Num $x, Num $y) Num;
sub ** :infix(POW) (Num $x, Num $y) Num;

# String
sub . :infix(ADD) (Str $x, Str $y) Str;

# Repetition: a list when the left operand is parenthesised and the call is
# in list context, `(1,2) x 2`; otherwise a string, `"ab" x 2`.
multi sub x :infix(MUL) :context(@) (List @l, Int $n) List;
multi sub x :infix(MUL) (Str $s, Int $n) Str;

# Numeric comparison
sub == :infix(EQUALITY) (Num $x, Num $y) Boolean;
sub != :infix(EQUALITY) (Num $x, Num $y) Boolean;
sub < :infix(RELATION) (Num $x, Num $y) Boolean;
sub > :infix(RELATION) (Num $x, Num $y) Boolean;
sub <= :infix(RELATION) (Num $x, Num $y) Boolean;
sub >= :infix(RELATION) (Num $x, Num $y) Boolean;
# undef when an operand is NaN: `("nan"+0) <=> 1`.
sub <=> :infix(ORDERING) (Num $x, Num $y) Int|Undef;

# String comparison
sub eq :infix(EQUALITY) (Str $x, Str $y) Boolean;
sub ne :infix(EQUALITY) (Str $x, Str $y) Boolean;
sub lt :infix(RELATION) (Str $x, Str $y) Boolean;
sub gt :infix(RELATION) (Str $x, Str $y) Boolean;
sub le :infix(RELATION) (Str $x, Str $y) Boolean;
sub ge :infix(RELATION) (Str $x, Str $y) Boolean;
sub cmp :infix(ORDERING) (Str $x, Str $y) Int;

# Logical
sub && :infix(LOGICAL_AND) (Any $x, Any $y) Any;
sub || :infix(LOGICAL_OR) (Any $x, Any $y) Any;
sub // :infix(LOGICAL_OR) (Any $x, Any $y) Any;
sub and :infix(LOGICAL_AND_LOW) (Any $x, Any $y) Any;
sub or :infix(LOGICAL_OR_LOW) (Any $x, Any $y) Any;
sub xor :infix(LOGICAL_OR_LOW) (Any $x, Any $y) Boolean;

# Bitwise
sub & :infix(BITAND) (Int $x, Int $y) Int;
sub | :infix(BITOR) (Int $x, Int $y) Int;
sub ^ :infix(BITOR) (Int $x, Int $y) Int;
sub << :infix(SHIFT) (Int $x, Int $y) Int;
sub >> :infix(SHIFT) (Int $x, Int $y) Int;

# Type test
sub isa :infix(ISA) (Scalar $x, Str $y) Boolean;

# Regex binding: in list context a match's captures, or s///'s count; in
# scalar context a match's boolean, s/// or tr///'s count, or s///r or
# tr///r's new string.
multi sub =~ :infix(MATCHRE) :context(@) (Str $x, Regex $y) List;
multi sub =~ :infix(MATCHRE) :context($) (Str $x, Regex $y) Boolean|Str;
sub !~ :infix(MATCHRE) (Str $x, Regex $y) Boolean;

# Range: a range in list context, a flip-flop in scalar context, whose
# result is a sequence number as a string ("", "1", "2", "3E0").
multi sub .. :infix(RANGE) :context(@) (Str $x, Str $y) List;
multi sub .. :infix(RANGE) :context($) (Any $x, Any $y) Str;
multi sub ... :infix(RANGE) :context(@) (Str $x, Str $y) List;
multi sub ... :infix(RANGE) :context($) (Any $x, Any $y) Str;

# Assignment
sub = :infix(ASSIGN) (Any $x, Any $y) Any;

# Unary
sub - :prefix (Num $x) Num;
sub + :prefix (Num $x) Num;
sub ! :prefix (Any $x) Boolean;
sub not :prefix (Any $x) Boolean;
sub ~ :prefix (Int $x) Int;
# A reference to each element of a parenthesised list in list context,
# `\(1,2,3)`; otherwise one reference.
multi sub \ :prefix :context(@) (List @l) List;
multi sub \ :prefix (Any $x) Ref;
