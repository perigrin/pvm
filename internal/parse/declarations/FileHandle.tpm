# ABOUTME: Declares what `use FileHandle` installs: Fcntl's default export list (constants), never its own methods.
# ABOUTME: Measured on perl 5.42.0 with FileHandle 2.05: FileHandle::import always re-exports @Fcntl::EXPORT, so a bare `use` installs 71 names.
package FileHandle;

# FileHandle's own @EXPORT is only _IOFBF, _IOLBF and _IONBF; its
# import() additionally calls Exporter::export('Fcntl', $callpkg) on
# every use, bare or not, which installs every name in @Fcntl::EXPORT.
# Each value here is the one Fcntl.tpm already measured for the same
# constant.
sub FD_CLOEXEC :export () Int;
sub F_ALLOCSP :export () None;
sub F_ALLOCSP64 :export () None;
sub F_COMPAT :export () None;
sub F_DUP2FD :export () None;
sub F_DUPFD :export () Int;
sub F_EXLCK :export () Int;
sub F_FREESP :export () None;
sub F_FREESP64 :export () None;
sub F_FSYNC :export () None;
sub F_FSYNC64 :export () None;
sub F_GETFD :export () Int;
sub F_GETFL :export () Int;
sub F_GETLK :export () Int;
sub F_GETLK64 :export () Int;
sub F_GETOWN :export () Int;
sub F_NODNY :export () None;
sub F_POSIX :export () None;
sub F_RDACC :export () None;
sub F_RDDNY :export () None;
sub F_RDLCK :export () Int;
sub F_RWACC :export () None;
sub F_RWDNY :export () None;
sub F_SETFD :export () Int;
sub F_SETFL :export () Int;
sub F_SETLK :export () Int;
sub F_SETLK64 :export () Int;
sub F_SETLKW :export () Int;
sub F_SETLKW64 :export () Int;
sub F_SETOWN :export () Int;
sub F_SHARE :export () None;
sub F_SHLCK :export () Int;
sub F_UNLCK :export () Int;
sub F_UNSHARE :export () None;
sub F_WRACC :export () None;
sub F_WRDNY :export () None;
sub F_WRLCK :export () Int;
sub O_ACCMODE :export () Int;
sub O_ALIAS :export () None;
sub O_APPEND :export () Int;
sub O_ASYNC :export () Int;
sub O_BINARY :export () Int;
sub O_CREAT :export () Int;
sub O_DEFER :export () None;
sub O_DIRECT :export () Int;
sub O_DIRECTORY :export () Int;
sub O_DSYNC :export () Int;
sub O_EXCL :export () Int;
sub O_EXLOCK :export () None;
sub O_LARGEFILE :export () Int;
sub O_NDELAY :export () Int;
sub O_NOCTTY :export () Int;
sub O_NOFOLLOW :export () Int;
sub O_NOINHERIT :export () None;
sub O_NONBLOCK :export () Int;
sub O_RANDOM :export () None;
sub O_RAW :export () None;
sub O_RDONLY :export () Int;
sub O_RDWR :export () Int;
sub O_RSRC :export () None;
sub O_RSYNC :export () Int;
sub O_SEQUENTIAL :export () None;
sub O_SHLOCK :export () None;
sub O_SYNC :export () Int;
sub O_TEMPORARY :export () None;
sub O_TEXT :export () Int;
sub O_TRUNC :export () Int;
sub O_WRONLY :export () Int;
# _IOFBF, _IOLBF and _IONBF are FileHandle's own @EXPORT, measured on
# IO::Handle (where the values come from) to be 0, 1 and 2.
sub _IOFBF :export () Int;
sub _IOLBF :export () Int;
sub _IONBF :export () Int;

# @EXPORT_OK: the same IO::Handle methods IO::Handle.tpm declares,
# re-exportable here under FileHandle's own name, plus pipe, the one
# sub FileHandle defines itself.
sub autoflush :export_ok (Object $self: Boolean $on = 1) Int;
sub format_formfeed :export_ok (Object $self: Optional[Str] $char) Str|Undef;
sub format_line_break_characters :export_ok (Object $self: Optional[Str] $chars) Str|Undef;
sub format_lines_left :export_ok (Object $self: Optional[Int] $n) Int;
sub format_lines_per_page :export_ok (Object $self: Optional[Int] $n) Int;
sub format_name :export_ok (Object $self: Optional[Str] $name) Str|Undef;
sub format_page_number :export_ok (Object $self: Optional[Int] $n) Int;
sub format_top_name :export_ok (Object $self: Optional[Str] $name) Str|Undef;
sub getline :export_ok (Object $self:) Str|Undef;
sub getlines :export_ok (Object $self:) List[Str];
sub input_line_number :export_ok (Object $self: Optional[Int] $n) Int|Undef;
sub input_record_separator :export_ok (Object $self: Optional[Str] $sep) Str|Undef;
sub output_field_separator :export_ok (Object $self: Optional[Str] $sep) Str|Undef;
sub output_record_separator :export_ok (Object $self: Optional[Str] $sep) Str|Undef;
# print and printf dereference the invocant as a glob before writing to
# it, dying "Can't use string ... as a symbol ref" against the oracle's
# bare class name, measured on 5.42.0, as IO::Handle's do; held to
# their prototype and exports only (see oracleExempt).
sub print :export_ok (Object $self: List @args) Boolean|Undef;
sub printf :export_ok (Object $self: Str $format, List @args) Boolean|Undef;
# pipe creates a connected pair of IO::Handle objects, returning them as
# a two-element list, or undef (never a list) on failure; measured on
# 5.42.0.
sub pipe :export_ok :listop () List[Object|Undef];
