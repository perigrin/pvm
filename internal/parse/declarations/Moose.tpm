# ABOUTME: Declares what `use Moose` defines in its caller, which Moose::Exporter builds out of sight.
# ABOUTME: Measured on perl 5.42.0 with Moose 2.4000: only blessed carries a prototype.
package Moose;

# Moose::Exporter's generated import reads only its leading '-' options
# (-traits, -excludes, -metaclass, ...) and otherwise ignores a use-list
# for DSL purposes (perigrin's ruling, 2026-10-20: "the parameters are
# the signature to import()"). Declaring it here, with no scalar key
# after the invocant, states that any non-empty list still installs the
# 13 sugar names below, as a bare `use Moose;` does -- measured on
# 5.42.0, `use Moose -traits => [];` installs all 13. $class is the
# invocant, so the colon keeps the derived prototype none, matching
# perl's (prototype() on Moose::import is undef).
sub import (Str $class: List @args) Void;

sub extends :export;
sub with :export;
sub has :export;
sub before :export;
sub after :export;
sub around :export;
sub override :export;
sub augment :export;
sub super :export;
sub inner :export;
sub confess :export;
sub blessed :export :prototype($);
sub meta :export;
