# ABOUTME: Declares what `use Moose` defines in its caller, which Moose::Exporter builds out of sight.
# ABOUTME: Measured on perl 5.42.0 with Moose 2.4000: only blessed carries a prototype.
package Moose;

sub extends :export;
sub with :export;
sub has :export;
sub before :export;
sub after :export;
sub around :export;
sub override :export;
sub augment :export;
sub super :export;
sub inner :export;
sub confess :export;
sub blessed :export :prototype($);
sub meta :export;
