# ABOUTME: Declares what `use Cwd` exports: cwd, getcwd, fastcwd and fastgetcwd are :export, the
# ABOUTME: rest :export_ok, measured. Measured on perl 5.42.0 with Cwd 3.75.

package Cwd;

# cwd, getcwd, fastcwd and fastgetcwd all return the process's current
# working directory and read no argument. None has a prototype perl
# reports (measured `prototype(\&Cwd::cwd)` undef), so each is
# :listop: an empty typed signature alone would derive the explicit
# "()" perl does not report. getcwd and fastcwd are undef on error
# (perldoc: "On error returns C<undef>, with C<$!> set", and fastcwd's
# own "If fastcwd encounters a problem it will return undef"); measured
# from a directory removed out from under the process, both are undef,
# where cwd and fastgetcwd instead give the empty string there.
# Arguments are ignored by all but fastcwd: measured with perl -w,
# cwd(1,2,3), getcwd(1,2,3) and fastgetcwd(1,2,3) run silently (getcwd
# is XS declared `getcwd(...)`, cwd and fastgetcwd the same Perl sub),
# so @ignored takes them; fastcwd(1) dies "Usage: Cwd::fastcwd()".
sub cwd :export :listop (List @ignored) Str;
sub getcwd :export :listop (List @ignored) Str|Undef;
sub fastcwd :export :listop () Str|Undef;
sub fastgetcwd :export :listop (List @ignored) Str;

# chdir changes the working directory and returns a plain integer,
# not a builtin boolean: measured on 5.42.0 with `use builtin
# qw(is_bool)`, `is_bool(chdir("/no/such/dir"))` is 0, where
# `chdir("/no/such/dir")` itself is 0 and `chdir(".")` is 1. No
# prototype is reported, so :listop states its one typed parameter.
# $dir is optional: the source reads `my $newdir = @_ ? shift : '';
# # allow for no arg (chdir to HOME dir)`, and measured,
# `Cwd::chdir()` returns 0 without dying. It also takes a handle, as
# POSIX::chdir does: Cwd::chdir's own source passes $newdir straight
# through to CORE::chdir, measured, `Cwd::chdir($dirhandle)` (an
# opendir lexical) and `Cwd::chdir(\*DH)` (a bareword glob ref) both
# return 1 and land in that directory. Further arguments are ignored:
# measured, `Cwd::chdir("/", 2)` returns 1 under perl -w.
sub chdir :export_ok :listop (Optional[Str|FileHandle] $dir, List @ignored) Int;

# abs_path, fast_abs_path, realpath and fast_realpath resolve a path to
# an absolute one with symlinks collapsed, defaulting to the current
# directory, and are undef for a path that does not exist. Measured on
# 5.42.0, `abs_path()` and `abs_path(".")` agree, and
# `abs_path("/no/such/path")` is undef. None has a prototype perl
# reports. abs_path and realpath are one XS sub taking at most one
# argument: measured, `abs_path(".", 2)` dies "Usage:
# Cwd::abs_path(pathsv=Nullsv)". fast_abs_path and fast_realpath are
# one Perl sub that ignores the rest: `fast_abs_path(".", 2, 3)` runs
# silently under perl -w.
sub abs_path :export_ok :listop (Str $path = ".") Str|Undef;
sub fast_abs_path :export_ok :listop (Str $path = ".", List @ignored) Str|Undef;
sub realpath :export_ok :listop (Str $path = ".") Str|Undef;
sub fast_realpath :export_ok :listop (Str $path = ".", List @ignored) Str|Undef;
