multi sub unpack_sockaddr_in :export :listop (Str $sin) Str;
multi sub unpack_sockaddr_in6 :export :listop (Str $sin6) List[Int|Str];
multi sub unpack_sockaddr_in6 :export :listop (Str $sin6) Str;
sub unpack_sockaddr_un :export :listop (Str $sun) Str;

# new, connect and the four host/port readers are genuine methods
# (IO::Socket::IP->new, $sock->connect, ...), so each takes an invocant.
# new alone is safe to call with no arguments (measured: builds and
# blesses a fresh, unconnected socket, no network); the rest open or read
# a real connection and are exempt (reason in returntypes_test.go).
sub new (Str $class: List @args) Object;
sub connect (Object $self: Optional[Str] $peer) Object|Undef;
sub sockhost (Object $self:) Str|Undef;
sub sockport (Object $self:) Int|Undef;
sub peerhost (Object $self:) Str|Undef;
sub peerport (Object $self:) Int|Undef;
