# IO::Socket::import forwards any non-empty import list straight to
# Exporter::export('Socket', $callpkg, @_) (measured, IO/Socket.pm:37),
# so every name and tag Socket.tpm marks :export_ok is also installable
# through IO::Socket, by the same name and tag: measured, `use IO::Socket
# qw(:addrinfo)` and `use IO::Socket qw(:crlf)` install the same names
# `use Socket qw(:addrinfo)`/`qw(:crlf)` do, and `use IO::Socket
# qw(:all)` installs the same 223 names `use Socket qw(:all)` does. Each
# one's type is the one Socket.tpm already measures for the same name.
sub AI_ADDRCONFIG :export_ok(addrinfo,all) () Int;
sub AI_ALL :export_ok(addrinfo,all) () Int;
sub AI_CANONIDN :export_ok(addrinfo,all) () Int;
sub AI_CANONNAME :export_ok(addrinfo,all) () Int;
sub AI_IDN :export_ok(addrinfo,all) () Int;
sub AI_IDN_ALLOW_UNASSIGNED :export_ok(addrinfo,all) :listop () None;
sub AI_IDN_USE_STD3_ASCII_RULES :export_ok(addrinfo,all) :listop () None;
sub AI_NUMERICHOST :export_ok(addrinfo,all) () Int;
sub AI_NUMERICSERV :export_ok(addrinfo,all) () Int;
sub AI_PASSIVE :export_ok(addrinfo,all) () Int;
sub AI_V4MAPPED :export_ok(addrinfo,all) () Int;
sub CR :export_ok(crlf,all) () Str;
sub CRLF :export_ok(crlf,all) () Str;
# $CR, $LF and $CRLF are Socket's own package variables, forwarded here
# the same way every sub above is (measured: `use IO::Socket qw($CR)`
# installs it, aliased to Socket::CR's own scalar slot). They are left
# undeclared: IO::Socket's own package never mentions them, so the
# shared export-marks check (held_to_perl.pl's installed(), which
# compares a caller's aliased slot against MODULE's own) has no
# IO::Socket::CR slot of its own to compare against and always misses
# them, the same blind spot Socket.tpm's own comment about re-exports
# living in another package's stash already describes for methods.
sub EAI_ADDRFAMILY :export_ok(addrinfo,all) () Int;
sub EAI_AGAIN :export_ok(addrinfo,all) () Int;
sub EAI_BADFLAGS :export_ok(addrinfo,all) () Int;
sub EAI_BADHINTS :export_ok(addrinfo,all) () None;
sub EAI_FAIL :export_ok(addrinfo,all) () Int;
sub EAI_FAMILY :export_ok(addrinfo,all) () Int;
