# getaddrinfo's and getnameinfo's error value is always a dualvar, and
# Str stays alongside DualVar for the same reason Socket.tpm's own
# comment gives: the oracle's observer cannot detect isdual yet
# (01a15aaa).
multi sub getaddrinfo :export_ok(addrinfo,all) :listop (Str|Undef $host, Str|Int|Undef $service = undef, HashRef $hints = undef) List[Str|HashRef|DualVar];
multi sub getaddrinfo :export_ok(addrinfo,all) :listop (Str|Undef $host, Str|Int|Undef $service = undef, HashRef $hints = undef) HashRef|Str|DualVar;
multi sub getnameinfo :export_ok(addrinfo,all) :listop (Str $sockaddr, Int $flags = 0, Int $xflags = 0) List[Str|Int|Undef|DualVar];
multi sub getnameinfo :export_ok(addrinfo,all) :listop (Str $sockaddr, Int $flags = 0, Int $xflags = 0) Str|Int|Undef|DualVar;
# interface_addr and port are measured accepting an explicit undef
# silently, as Socket.tpm's own comments explain for the same names.
sub pack_ip_mreq :export_ok(all) :listop (Str $mcast_addr, Str|Undef $interface_addr = "\0\0\0\0") Str;
sub pack_ip_mreq_source :export_ok(all) :listop (Str $mcast_addr, Str $source_addr, Str|Undef $interface_addr = "\0\0\0\0") Str;
sub pack_ipv6_mreq :export_ok(all) :listop (Str $addr, Int $interface) Str;
sub pack_sockaddr_in :export(all) :listop (Int|Undef $port, Str $addr) Str;
sub pack_sockaddr_in6 :export(all) :listop (Int|Undef $port, Str $addr, Int $scope_id = 0, Int $flowinfo = 0) Str;
sub pack_sockaddr_un :export(all) :listop (Str $path) Str;
sub sockaddr_family :export(all) :listop (Str $sockaddr) Int;
# sockaddr_in, sockaddr_in6 and sockaddr_un dispatch on wantarray (and,
# for sockaddr_in/in6, arity) together, as Socket.tpm's own comments
# explain; IO::Socket's are held to their prototype and exports only,
# as Socket's already are (see oracleExempt).
multi sub sockaddr_in :export(all) :listop (Int|Undef $port, Str $addr) Str;
multi sub sockaddr_in :export(all) :listop (Str $sin) List[Int|Str];
multi sub sockaddr_in6 :export(all) :listop (Int|Undef $port, Str $addr, Int $scope_id = 0, Int $flowinfo = 0) Str;
multi sub sockaddr_in6 :export(all) :listop (Str $sin6) List[Int|Str];
multi sub sockaddr_un :export(all) :listop (Str $path) Str;
multi sub sockaddr_un :export(all) :listop (Str $sun) List[Str];
multi sub unpack_ip_mreq :export_ok(all) :listop (Str $mreq) List[Str];
multi sub unpack_ip_mreq :export_ok(all) :listop (Str $mreq) Str;
multi sub unpack_ip_mreq_source :export_ok(all) :listop (Str $mreq) List[Str];
multi sub unpack_ip_mreq_source :export_ok(all) :listop (Str $mreq) Str;
multi sub unpack_ipv6_mreq :export_ok(all) :listop (Str $mreq) List[Str|Int];
multi sub unpack_ipv6_mreq :export_ok(all) :listop (Str $mreq) Int;
multi sub unpack_sockaddr_in :export(all) :listop (Str $sin) List[Int|Str];
multi sub unpack_sockaddr_in :export(all) :listop (Str $sin) Str;
multi sub unpack_sockaddr_in6 :export(all) :listop (Str $sin6) List[Int|Str];
multi sub unpack_sockaddr_in6 :export(all) :listop (Str $sin6) Str;
sub unpack_sockaddr_un :export(all) :listop (Str $sun) Str;

sub sockatmark :export_ok (FileHandle $handle) Str|Undef;

# Methods beside the exports. Measured on 5.42.0, new() works with the
# class name itself as its invocant, as the return-type oracle calls
# it: with no arguments it returns a blessed but unconfigured
# IO::Socket; given a Domain (and the rest a concrete subclass needs)
# it configures and returns a real, usable socket, or undef on failure
# (POD: "If the constructor fails it will return undef"), measured:
# IO::Socket->new(Domain=>AF_INET, Type=>SOCK_STREAM, PeerPort=>1, ...)
# fails to connect and returns undef. socket, connect, bind and listen
# each return the invocant itself on success or undef on failure
# (measured; IO/Socket.pm:91,165,223,233), never the Boolean the
# connect/bind/listen core builtins themselves return. accept returns a
# two-element (new socket, peer address) list in list context and the
# new socket (or undef) in scalar (POD), and also accepts an object
# where a subclass name is expected (measured: `$pkg = shift || $sock`).
# send's flags is measured optional (POD: `send(BUF, [FLAGS, [TO]])`).
# socket, connect, bind, listen, accept, send, recv and close each
# operate on a real socket file descriptor the invocant must already
# hold -- opening, connecting to, or writing on the network -- and each
# also dereferences the invocant as a glob first, dying "Can't use
# string ... as a symbol ref" when it is the bare class name; they are
# declared and held to their prototype and exports only (see
# oracleExempt).
sub new (Str $class: List @args) Object|Undef;
sub socket (Object $self: Int $domain, Int $type, Int $protocol) Object|Undef;
sub connect (Object $self: Str $addr) Object|Undef;
sub bind (Object $self: Str $addr) Object|Undef;
sub listen (Object $self: Optional[Int|Undef] $queue) Object|Undef;
multi sub accept (Object $self: Optional[Str|Object] $class) List[Object|Str];
multi sub accept (Object $self: Optional[Str|Object] $class) Object|Undef;
sub send (Object $self: Str $buf, Optional[Int] $flags, Optional[Str] $to) Int|Undef;
sub recv (Object $self: Scalar \$buf, Int $len, Optional[Int] $flags) Str|Undef;
sub close (Object $self:) Boolean;

# Methods documented at IO/Socket.pm:445-825 (and two undocumented ones,
# configure and register_domain) that a prior pass of this .tpm left
# out. Each is measured on a freshly built, unconnected UDP socket
# (IO::Socket->new(Domain=>AF_INET, Type=>SOCK_DGRAM, Proto=>'udp')),
# which never touches the network -- socket(2) alone, no connect or
# bind -- so none needs the network exemption socket/connect/accept and
# the rest above do.
sub blocking (Object $self: Optional[Int] $block) Int|Undef;
sub sockname (Object $self:) Str|Undef;
sub peername (Object $self:) Str|Undef;
sub connected (Object $self:) Str|Undef;
# shutdown returns a plain Int, 1 on success or 0 on failure with $!
# set (POD), never a core is_bool value (measured, both branches), and
# undef when the invocant is not a valid filehandle (POD).
sub shutdown (Object $self: Int $how) Int|Undef;
sub setsockopt (Object $self: Int $level, Int $optname, Int|Str $optval) Boolean|Undef;
# getsockopt unpacks a 4-byte (native int-size) result to an Int as "just
# a guess" (IO/Socket.pm's own comment); any other size stays the packed
# Str perl's core getsockopt returns, or undef on failure.
sub getsockopt (Object $self: Int $level, Int $optname) Int|Str|Undef;
# sockopt is getsockopt's and setsockopt's own unified form (POD):
# one argument reads, two write, so it answers either one's return type.
sub sockopt (Object $self: Int $optname, Optional[Int] $value) Int|Str|Boolean|Undef;
sub atmark (Object $self:) Str|Undef;
sub timeout (Object $self: Optional[Num] $seconds) Num|Undef;
sub sockdomain (Object $self:) Int|Undef;
sub socktype (Object $self:) Int|Undef;
sub protocol (Object $self:) Int|Undef;
# socketpair is a class method (POD: `IO::Socket->socketpair(...)`),
# returning the two connected sockets it creates, or the empty list on
# failure (POD: "or an empty list on failure").
sub socketpair (Str $class: Int $domain, Int $type, Int $protocol) List[Object];
# configure is undocumented (no POD =head2); new calls it internally
# once Domain is known, blessing the invocant into the right subclass
# and delegating to its own configure, measured returning that
# subclass's own IO::Socket::INET object, or undef on a bad domain.
sub configure (Object $self: HashRef $arg) Object|Undef;
# register_domain is undocumented (no POD =head2); called as
# Subclass->register_domain(DOMAIN) at each subclass's own load time
# (measured, IO::Socket::INET.pm, IO::Socket::UNIX.pm), returning the
# class name it was called with.
sub register_domain (Str $class: Int $domain) Str;
