# ABOUTME: Declares what `use IO::Socket` installs: Socket's default export list, re-exported, plus sockatmark and Socket's own :export_ok names on request.
# ABOUTME: Measured on perl 5.42.0 with IO::Socket 1.55: its bare install is byte-for-byte Socket's own (170 names); every value is the one Socket.tpm already measures.
package IO::Socket;

# IO::Socket::import, given no arguments, calls Exporter::export
# ('Socket', $callpkg) -- Socket's own default list (its ":export"
# names, not its ":all" tag, which also holds names ':export_ok' asks
# for). Measured on 5.42.0: `use IO::Socket;` and `use Socket;` install
# exactly the same 170 names; every value here is the one Socket.tpm
# already measures for the same constant or function.
