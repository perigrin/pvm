sub inet_aton :export :listop (Str $hostname) Str|Undef;
sub inet_ntoa :export :listop (Str $addr) Str;
sub pack_sockaddr_in :export :listop (Int $port, Str $addr) Str;
sub pack_sockaddr_in6 :export :listop (Int $port, Str $addr, Int $scope_id = 0, Int $flowinfo = 0) Str;
sub pack_sockaddr_un :export :listop (Str $path) Str;
sub sockaddr_family :export :listop (Str $sockaddr) Int;
# sockaddr_in and sockaddr_in6 dispatch on wantarray and arity
# together, as Socket.tpm's own comment explains; IO::Socket's are
# held to their prototype and exports only, as Socket's already are
# (see oracleExempt).
multi sub sockaddr_in :export :listop (Int $port, Str|Undef $addr) Str;
multi sub sockaddr_in :export :listop (Str $sin) List[Int|Str];
multi sub sockaddr_in6 :export :listop (Int $port, Str $addr, Int $scope_id = 0, Int $flowinfo = 0) Str;
multi sub sockaddr_in6 :export :listop (Str $sin6) List[Int|Str];
sub sockaddr_un :export :listop (Str $path) Str;
multi sub unpack_sockaddr_in :export :listop (Str $sin) List[Int|Str];
multi sub unpack_sockaddr_in :export :listop (Str $sin) Str;
multi sub unpack_sockaddr_in6 :export :listop (Str $sin6) List[Int|Str];
multi sub unpack_sockaddr_in6 :export :listop (Str $sin6) Str;
sub unpack_sockaddr_un :export :listop (Str $sun) Str;

sub sockatmark :export_ok (FileHandle $handle) Boolean|Undef;

# Methods beside the exports. Measured on 5.42.0, new() works with the
# class name itself as its invocant, as the return-type oracle calls
# it, returning a blessed but unconfigured IO::Socket. socket, connect,
# bind, listen, accept, send, recv and close each operate on a real
# socket file descriptor the invocant must already hold -- opening,
# connecting to, or writing on the network -- and each also
# dereferences the invocant as a glob first, dying "Can't use string
# ... as a symbol ref" when it is the bare class name; they are
# declared and held to their prototype and exports only (see
# oracleExempt).
sub new (Str $class:) Object;
sub socket (Object $self: Int $domain, Int $type, Int $protocol) Boolean;
sub connect (Object $self: Str $addr) Boolean;
sub bind (Object $self: Str $addr) Boolean;
sub listen (Object $self: Optional[Int] $queue) Boolean;
sub accept (Object $self: Optional[Str] $class) Object|Undef;
sub send (Object $self: Str $buf, Int $flags, Optional[Str] $to) Int|Undef;
sub recv (Object $self: Scalar \$buf, Int $len, Optional[Int] $flags) Str|Undef;
sub close (Object $self:) Boolean;
