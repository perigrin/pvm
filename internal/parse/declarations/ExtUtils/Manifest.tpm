# ABOUTME: Declares what `use ExtUtils::Manifest` installs: every name is export_ok, none exported bare.
# ABOUTME: Measured on perl 5.42.0 with ExtUtils::Manifest 1.75, called in a scratch directory.
package ExtUtils::Manifest;

# manifind, manicheck, filecheck, fullcheck and skipcheck read the
# current directory and the MANIFEST there; manicopy, maniadd and
# mkmanifest write to it. Measured on 5.42.0, calling each in a scratch
# directory keeps every read and write inside it.
sub manifind :export_ok :listop (Optional[HashRef] $p) HashRef;
# manicheck, filecheck and skipcheck each end `return @missfile;` (or
# the equivalent); in scalar context perl evaluates that array in the
# caller's context and gives its count, an Int (measured: manicheck()
# in scalar context gives 1, filecheck() gives 2; audit-C.md finding
# 19), as File::Spec.tpm already declares for no_upwards. manicheck,
# filecheck and fullcheck call their helpers with no arguments, so
# their own are ignored: measured, `manicheck(1, 2)` runs silently
# under perl -w. skipcheck copies its first argument into a lexical,
# `my($p) = @_`, that it never reads: measured, `skipcheck(undef, {},
# 3)`, `skipcheck('x')` and `skipcheck()` all run silently. $p is `Any
# $p = undef`, not Optional[Any]: Any already holds Void, so Optional
# would add nothing and leave $p required (RFC 0001, "Optional[T] is
# Void|T"); the default is what `my($p) = @_` reads with no argument.
multi sub manicheck :export_ok :listop (List @ignored) List[Str];
multi sub manicheck :export_ok :listop (List @ignored) Int;
multi sub filecheck :export_ok :listop (List @ignored) List[Str];
multi sub filecheck :export_ok :listop (List @ignored) Int;
# fullcheck returns a two-element list, ($missing, $extra), each an
# ArrayRef: measured on 5.42.0.
sub fullcheck :export_ok :listop (List @ignored) List[ArrayRef];
multi sub skipcheck :export_ok :listop (Any $p = undef, List @ignored) List[Str];
multi sub skipcheck :export_ok :listop (Any $p = undef, List @ignored) Int;
sub maniread :export_ok :listop (Optional[Str] $file) HashRef;
# maniskip returns a closure that tests one filename against
# MANIFEST.SKIP; measured on 5.42.0.
sub maniskip :export_ok :listop (Optional[Str] $file) CodeRef;
# maniadd always returns 1 on success and dies on a write failure;
# measured on 5.42.0.
sub maniadd :export_ok :listop (HashRef $additions) Int;
# mkmanifest and manicopy are called for their side effect of writing
# files; perl's own return value for each is unspecified by its docs and
# not meant to be read, measured on 5.42.0 to be an empty string or a
# foreach loop's last iteration, neither a stable contract. mkmanifest's
# body never reads @_, so it takes and ignores any arguments: read from
# its source, not run, since a call writes MANIFEST.
sub mkmanifest :export_ok :listop (List @ignored) Any;
sub manicopy :export_ok :listop (HashRef $read, Str $target, Optional[Str] $how) Any;
