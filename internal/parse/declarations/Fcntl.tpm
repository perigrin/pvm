# ABOUTME: Declares what `use Fcntl` installs: every exported name's :export/:export_ok
# ABOUTME: mark, tags and prototype. Measured on perl 5.42.0 with Fcntl 1.20.
#
# Every exported name takes a () prototype and is a constant, except for
# S_IFMT, S_IMODE and the ten S_IS* mode-test functions, which take the
# mode integer stat returns and have no prototype perl can report
# (measured: prototype() is undef for each).
#
# 48 of the constants are macros this platform does not define: each
# one's AUTOLOAD stub dies calling it (measured: "Usage: Fcntl::AUTOLOAD()"
# or "Your vendor has not defined Fcntl macro ..."), so each is None,
# never returning, as CORE.tpm types `die`. S_ISWHT (whiteout files) dies
# the same way for the same reason -- S_IFWHT, the constant it tests
# against, is one of the 48 -- so it is None too, though it has no
# prototype of its own.
package Fcntl;
sub DN_ACCESS :export_ok () Int;
sub DN_ATTRIB :export_ok () Int;
sub DN_CREATE :export_ok () Int;
sub DN_DELETE :export_ok () Int;
sub DN_MODIFY :export_ok () Int;
sub DN_MULTISHOT :export_ok () Int;
sub DN_RENAME :export_ok () Int;
sub FAPPEND :export_ok(Fcompat) () Int;
sub FASYNC :export_ok(Fcompat) () Int;
sub FCREAT :export_ok(Fcompat) () None;
sub FDEFER :export_ok(Fcompat) () None;
sub FDSYNC :export_ok(Fcompat) () None;
sub FD_CLOEXEC :export () Int;
sub FEXCL :export_ok(Fcompat) () None;
sub FLARGEFILE :export_ok(Fcompat) () None;
sub FNDELAY :export_ok(Fcompat) () Int;
sub FNONBLOCK :export_ok(Fcompat) () Int;
sub FRSYNC :export_ok(Fcompat) () None;
sub FSYNC :export_ok(Fcompat) () None;
sub FTRUNC :export_ok(Fcompat) () None;
sub F_ADD_SEALS :export_ok () Int;
sub F_ALLOCSP :export () None;
sub F_ALLOCSP64 :export () None;
sub F_COMPAT :export () None;
sub F_DUP2FD :export () None;
sub F_DUPFD :export () Int;
sub F_EXLCK :export () Int;
sub F_FREESP :export () None;
sub F_FREESP64 :export () None;
sub F_FSYNC :export () None;
sub F_FSYNC64 :export () None;
sub F_GETFD :export () Int;
sub F_GETFL :export () Int;
sub F_GETLEASE :export_ok () Int;
sub F_GETLK :export () Int;
sub F_GETLK64 :export () Int;
sub F_GETOWN :export () Int;
sub F_GETPIPE_SZ :export_ok () Int;
sub F_GETSIG :export_ok () Int;
sub F_GET_SEALS :export_ok () Int;
sub F_NODNY :export () None;
sub F_NOTIFY :export_ok () Int;
sub F_POSIX :export () None;
sub F_RDACC :export () None;
sub F_RDDNY :export () None;
sub F_RDLCK :export () Int;
sub F_RWACC :export () None;
sub F_RWDNY :export () None;
sub F_SEAL_FUTURE_WRITE :export_ok () Int;
sub F_SEAL_GROW :export_ok () Int;
sub F_SEAL_SEAL :export_ok () Int;
sub F_SEAL_SHRINK :export_ok () Int;
sub F_SEAL_WRITE :export_ok () Int;
sub F_SETFD :export () Int;
sub F_SETFL :export () Int;
sub F_SETLEASE :export_ok () Int;
sub F_SETLK :export () Int;
sub F_SETLK64 :export () Int;
sub F_SETLKW :export () Int;
sub F_SETLKW64 :export () Int;
sub F_SETOWN :export () Int;
sub F_SETPIPE_SZ :export_ok () Int;
sub F_SETSIG :export_ok () Int;
sub F_SHARE :export () None;
sub F_SHLCK :export () Int;
sub F_UNLCK :export () Int;
sub F_UNSHARE :export () None;
sub F_WRACC :export () None;
sub F_WRDNY :export () None;
sub F_WRLCK :export () Int;
# LOCK_EX, LOCK_SH, LOCK_NB and LOCK_UN carry the flock tag; the other
# flock-related constants below are export_ok only, under no tag.
sub LOCK_EX :export_ok(flock) () Int;
sub LOCK_MAND :export_ok () Int;
sub LOCK_NB :export_ok(flock) () Int;
sub LOCK_READ :export_ok () Int;
sub LOCK_RW :export_ok () Int;
sub LOCK_SH :export_ok(flock) () Int;
sub LOCK_UN :export_ok(flock) () Int;
sub LOCK_WRITE :export_ok () Int;
sub O_ACCMODE :export () Int;
sub O_ALIAS :export () None;
sub O_ALT_IO :export_ok () None;
sub O_APPEND :export () Int;
sub O_ASYNC :export () Int;
sub O_BINARY :export () Int;
sub O_CREAT :export () Int;
sub O_DEFER :export () None;
sub O_DIRECT :export () Int;
sub O_DIRECTORY :export () Int;
sub O_DSYNC :export () Int;
sub O_EVTONLY :export_ok () None;
sub O_EXCL :export () Int;
sub O_EXLOCK :export () None;
sub O_IGNORE_CTTY :export_ok () None;
sub O_LARGEFILE :export () Int;
sub O_NDELAY :export () Int;
sub O_NOATIME :export_ok () Int;
sub O_NOCTTY :export () Int;
sub O_NOFOLLOW :export () Int;
sub O_NOINHERIT :export () None;
sub O_NOLINK :export_ok () None;
sub O_NONBLOCK :export () Int;
sub O_NOSIGPIPE :export_ok () None;
sub O_NOTRANS :export_ok () None;
sub O_RANDOM :export () None;
sub O_RAW :export () None;
sub O_RDONLY :export () Int;
sub O_RDWR :export () Int;
sub O_RSRC :export () None;
sub O_RSYNC :export () Int;
sub O_SEQUENTIAL :export () None;
sub O_SHLOCK :export () None;
sub O_SYMLINK :export_ok () None;
sub O_SYNC :export () Int;
sub O_TEMPORARY :export () None;
sub O_TEXT :export () Int;
sub O_TMPFILE :export_ok () Int;
sub O_TRUNC :export () Int;
sub O_TTY_INIT :export_ok () None;
sub O_WRONLY :export () Int;
sub SEEK_CUR :export_ok(seek) () Int;
sub SEEK_END :export_ok(seek) () Int;
sub SEEK_SET :export_ok(seek) () Int;
sub S_ENFMT :export_ok(mode) () None;
sub S_IEXEC :export_ok(mode) () Int;
sub S_IFBLK :export_ok(mode) () Int;
sub S_IFCHR :export_ok(mode) () Int;
sub S_IFDIR :export_ok(mode) () Int;
sub S_IFIFO :export_ok(mode) () Int;
sub S_IFLNK :export_ok(mode) () Int;
# S_IFMT also takes no argument, real perl lib code calls it bare
# (IO::Compress::Zip's `$mode & S_IFMT`), and returns the bit mask
# itself then (measured: `S_IFMT()` is 61440, the same as `_S_IFMT`).
multi sub S_IFMT :export_ok(mode) :listop () Int;
multi sub S_IFMT :export_ok(mode) :listop (Int $mode) Int;
sub S_IFREG :export_ok(mode) () Int;
sub S_IFSOCK :export_ok(mode) () Int;
sub S_IFWHT :export_ok(mode) () None;
sub S_IMODE :export_ok(mode) :listop (Int $mode) Int;
sub S_IREAD :export_ok(mode) () Int;
sub S_IRGRP :export_ok(mode) () Int;
sub S_IROTH :export_ok(mode) () Int;
sub S_IRUSR :export_ok(mode) () Int;
sub S_IRWXG :export_ok(mode) () Int;
sub S_IRWXO :export_ok(mode) () Int;
sub S_IRWXU :export_ok(mode) () Int;
sub S_ISBLK :export_ok(mode) :listop (Int $mode) Boolean;
sub S_ISCHR :export_ok(mode) :listop (Int $mode) Boolean;
sub S_ISDIR :export_ok(mode) :listop (Int $mode) Boolean;
sub S_ISFIFO :export_ok(mode) :listop (Int $mode) Boolean;
sub S_ISGID :export_ok(mode) () Int;
sub S_ISLNK :export_ok(mode) :listop (Int $mode) Boolean;
sub S_ISREG :export_ok(mode) :listop (Int $mode) Boolean;
sub S_ISSOCK :export_ok(mode) :listop (Int $mode) Boolean;
sub S_ISTXT :export_ok(mode) () None;
sub S_ISUID :export_ok(mode) () Int;
sub S_ISVTX :export_ok(mode) () Int;
# S_ISWHT has no prototype and so measures as "Usage: Fcntl::AUTOLOAD()"
# on any call: S_IFWHT, which it tests against, is one of the 48
# platform-undefined macros, so S_ISWHT can never return.
sub S_ISWHT :export_ok(mode) :listop (Int $mode) None;
sub S_IWGRP :export_ok(mode) () Int;
sub S_IWOTH :export_ok(mode) () Int;
sub S_IWRITE :export_ok(mode) () Int;
sub S_IWUSR :export_ok(mode) () Int;
sub S_IXGRP :export_ok(mode) () Int;
sub S_IXOTH :export_ok(mode) () Int;
sub S_IXUSR :export_ok(mode) () Int;
sub _S_IFMT :export_ok(mode) () Int;
