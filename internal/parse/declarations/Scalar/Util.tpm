# ABOUTME: Declares what `use Scalar::Util` exports: every name is :export_ok, measured, so a bare
# ABOUTME: `use` imports nothing. Measured on perl 5.42.0 with Scalar::Util 1.68_01.

package Scalar::Util;

# blessed returns the class name of a blessed reference, or undef for
# anything else, including an unblessed reference. Measured on 5.42.0,
# `blessed({})` is undef and `blessed(bless {}, "Foo")` is "Foo".
sub blessed :export_ok :prototype($) (Any $ref) Str|Undef;

# dualvar builds one scalar holding a number and a string that differ,
# measured on 5.42.0: `dualvar(5, "five") + 0` is 5 and `"" . dualvar(5,
# "five")` is "five". Declared DualVar: the return-type oracle tells
# its dual nature apart from a plain Str. $num and $str stay Num/Str:
# measured, `dualvar("abc","x")`, `dualvar(undef,undef)` and
# `dualvar([1],[2])` all work rather than dying, but each is perl
# numifying or stringifying the argument the same way every other
# Num/Str parameter in this file is coerced (RFC 0001, "What a
# parameter type means": a finding that only shows perl coercing a
# value is not a gap in the coercion the type already states), not a
# value neither type covers.
sub dualvar :export_ok :prototype($$) (Num $num, Str $str) DualVar;

# isdual, isvstring, isweak, looks_like_number and readonly answer
# yes/no questions as perl's builtin booleans: measured on 5.42.0 with
# `use builtin qw(is_bool); no warnings
# 'experimental::builtin'`, `is_bool(isdual(dualvar(5,"five")))` and the
# others of this group but readonly and tainted are each 1.
sub isdual :export_ok :prototype($) (Any $v) Boolean;
sub isvstring :export_ok :prototype($) (Any $v) Boolean;
sub isweak :export_ok :prototype($) (Any $v) Boolean;
sub looks_like_number :export_ok :prototype($) (Any $v) Boolean;

# openhandle returns the handle it was given unchanged when it is open,
# undef otherwise: measured on 5.42.0, `ref(openhandle($fh))` for a
# lexical filehandle is "GLOB" (a GlobRef), `ref \openhandle(*STDIN)`
# is GLOB (a bare Glob, not a reference to one -- a direct `ref`
# reports "" for it, since it is not itself a reference), `ref
# openhandle(IO::File->new(...))` is "IO::File" (an Object), and
# `openhandle("x")` is undef. The oracle's own Scalar-Util.pl omits the
# bare-glob case: its observer classifies by `ref($v)`, which cannot
# tell a bare Glob apart from a plain Str (both report ""), the same
# limitation dualvar's own comment above notes.
sub openhandle :export_ok :prototype($) (Any $v) Glob|GlobRef|Object|Undef;

# readonly and tainted measured on 5.42.0 are plain integers, not
# builtin booleans: `is_bool(readonly(5))` and `is_bool(tainted($x))`
# are both 0, unlike isdual's group above.
sub readonly :export_ok :prototype($) (Any $v) Int;

# refaddr is the reference's address as an integer, or undef for a
# non-reference. reftype is the underlying type Perl's `ref` names
# ("HASH", "ARRAY", ...), or undef for a non-reference. Measured on
# 5.42.0 with a blessed hashref: refaddr matches qr/^\d+$/ and reftype
# is "HASH"; on a plain number both are undef. Both are defined for
# ANY reference, blessed or not, so a candidate on Ref alone drops the
# Undef a call on an argument already proven a reference would
# otherwise carry (RFC 0001, "Multi declarations": the more specific
# candidate wins only where the argument's type is wholly Ref). The
# `Any` candidate keeps the original `Int|Undef`/`Str|Undef`, not bare
# Undef: an argument whose type is a union that still has non-Ref bits
# (an unnarrowed `my ($x) = @_`, typed Scalar) fits only this
# candidate, and perl can still return a defined value for it at
# runtime, so the safe join is kept rather than overclaiming Undef.
multi sub refaddr :export_ok :prototype($) (Ref $ref) Int;
multi sub refaddr :export_ok :prototype($) (Any $ref) Int|Undef;
multi sub reftype :export_ok :prototype($) (Ref $ref) Str;
multi sub reftype :export_ok :prototype($) (Any $ref) Str|Undef;

# set_prototype takes a sub, as a block or a coderef, and a prototype
# string, and returns the same coderef with that prototype set.
# Measured on 5.42.0, `ref(set_prototype(sub { 42 }, '$$'))` is "CODE".
# $proto also takes undef, documented to remove the prototype ("If
# $prototype is undef, then the function's prototype is removed"),
# measured to work rather than die.
sub set_prototype :export_ok :prototype(&$) (Code &code, Str|Undef $proto) CodeRef;

# tainted: see readonly above.
sub tainted :export_ok :prototype($) (Any $v) Int;

# weaken and unweaken return nothing: measured on 5.42.0, `my @l =
# weaken($ref)` leaves @l empty and `my $s = weaken($ref)` leaves $s
# undef, the signature of a bare `return`. $ref is not Any: measured,
# `weaken($x)` with $x holding a plain number dies "Can't weaken a
# nonreference", and so does `weaken(5)` -- values Any admits that perl
# has no coercion for and dies on (RFC 0001, "What a parameter type
# means"), unlike undef, which weaken accepts (measured, a no-op).
sub weaken :export_ok :prototype($) (Ref|Undef $ref) Void;
sub unweaken :export_ok :prototype($) (Ref|Undef $ref) Void;
