KW_USE_or_NO
BAREWORD
BAREWORD	PV("FindBin"\0)
PERLY_SEMICOLON
KW_USE_or_NO
BAREWORD
BAREWORD	PV("lib"\0)
FUNC	op_stringify
SUBLEXSTART
PERLY_DOLLAR
BAREWORD	PV("FindBin::Bin"\0)
ADDOP	op_concat
THING	PV("/tdt-stubs"\0)
SUBLEXEND
PERLY_SEMICOLON
KW_USE_or_NO
BAREWORD
BAREWORD	PV("TdtStub"\0)
PERLY_SEMICOLON
KW_MY
PERLY_DOLLAR
PRIVATEREF	$name
ASSIGNOP	op_null
THING	PV("world"\0)
PERLY_SEMICOLON
KW_MY
PERLY_PERCENT_SIGN
PRIVATEREF	%h
ASSIGNOP	op_null
PERLY_PAREN_OPEN
BAREWORD	PV("greeting"\0)
PERLY_COMMA
FUNC	op_stringify
SUBLEXSTART
THING	PV("hello, "\0)
ADDOP	op_concat
PERLY_DOLLAR
PRIVATEREF	$name
SUBLEXEND
PERLY_PAREN_CLOSE
PERLY_SEMICOLON
LSTOP	op_print
FUNC	op_scalar
SUBLEXSTART
PERLY_DOLLAR
PRIVATEREF	%h
PERLY_BRACE_OPEN
BAREWORD	PV("greeting"\0)
PERLY_SEMICOLON
PERLY_BRACE_CLOSE
ADDOP	op_concat
THING	PV("\n"\0)
SUBLEXEND
PERLY_SEMICOLON
KW_SUB_named
BAREWORD	PV("later"\0)
PERLY_BRACE_OPEN
KW_REQUIRE
BAREWORD	PV("TdtLater"\0)
PERLY_SEMICOLON
PERLY_AMPERSAND
