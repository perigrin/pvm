+
+var measureDesign, measureRuleOff, measureTC bool
+
+func emitNot(b *canonBuf, c *Node, src []byte, f int) {
+	var arg canonBuf
+	if c.Paren {
+		emit(&arg, c, src, 0)
+		text := arg.String()
+		b.WriteString("not ")
+		if strings.HasPrefix(text, "(") && leadingParenCloses(text) {
+			b.writeFrom(&arg, 0, len(text))
+			return
+		}
+		b.writeParenNode('(')
+		b.writeFrom(&arg, 0, len(text))
+		b.writeParenNode(')')
+		return
+	}
+	group := f > prefix["not"]
+	next := f
+	if group {
+		next = 0
+	}
+	emitBefore(&arg, c, src, prefix["not"]+1, next)
+	text := arg.String()
+	if strings.HasPrefix(text, "(") && !leadingParenCloses(text) {
+		b.WriteString("not(")
+		b.writeFrom(&arg, 0, len(text))
+		b.WriteByte(')')
+		return
+	}
+	if group {
+		b.WriteByte('(')
+	}
+	b.WriteString("not ")
+	b.writeFrom(&arg, 0, len(text))
+	if group {
+		b.WriteByte(')')
+	}
+}
+
+// emitBareCall writes a list op/call without ArgParen bare; n.Text may be
+// empty (indirect args). Returns false to fall back to call parens.
+func emitBareCall(b *canonBuf, n *Node, src []byte, f int) bool {
+	if len(n.Children) == 0 {
+		b.WriteString(n.Text)
+		return true
+	}
+	if f > bpListOp && !(measureTC && n.Children[len(n.Children)-1].TrailingComma != "") {
+		return false
+	}
+	if len(n.Children) == 1 && n.Children[0].Kind == Block {
+		return false
+	}
+	var arg canonBuf
+	for i, c := range n.Children {
+		if i > 0 {
+			arg.WriteByte(' ')
+		}
+		next := 0
+		if i == len(n.Children)-1 {
+			next = f
+		}
+		emitBefore(&arg, c, src, bpListOp+1, next)
+	}
+	text := arg.String()
+	if strings.HasPrefix(text, "(") && !leadingParenCloses(text) {
+		return false
+	}
+	if n.Text != "" {
+		b.WriteString(n.Text)
+		b.WriteByte(' ')
+	}
+	b.writeFrom(&arg, 0, len(text))
+	return true
+}
