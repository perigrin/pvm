new file mode 100644
index 00000000..a90bc654
--- /dev/null
+++ b/internal/parse/splice_test.go
@@ -0,0 +1,142 @@
+// ABOUTME: Repair's splice under the root-edge-delta ruling (§6.4.2): it touches only the damaged path and shares the rest.
+// ABOUTME: Old and new trees both read as fresh parses of their own bytes, through ten successive repairs.
+package parse
+
+import (
+	"slices"
+	"strings"
+	"testing"
+)
+
+// scaleEdits is a 1-char edit in the first, middle and last `sub scale`
+// of src, each of src itself: spliceEdits' edits 0, n/2 and n-1.
+func scaleEdits(t *testing.T, src []byte) []Edit {
+	t.Helper()
+	n := strings.Count(string(src), "\nsub scale {")
+	es := spliceEdits(t, src, n)
+	// Edit k of the sequence applies to the buffer edits 0..k-1 left; each
+	// of these first moves left by the digits inserted before it.
+	first, mid, last := es[0], es[n/2], es[n-1]
+	mid.Start, mid.OldEnd = mid.Start-n/2, mid.OldEnd-n/2
+	last.Start, last.OldEnd = last.Start-(n-1), last.OldEnd-(n-1)
+	return []Edit{first, mid, last}
+}
+
+// reachable is every node reachable from n, children and inner heredoc
+// bodies alike, each once.
+func reachable(n *Node) map[*Node]bool {
+	seen := map[*Node]bool{}
+	var walk func(*Node)
+	walk = func(n *Node) {
+		if seen[n] {
+			return
+		}
+		seen[n] = true
+		for _, c := range n.Children {
+			walk(c)
+		}
+		for _, c := range n.InnerHeredocBodies {
+			walk(c)
+		}
+	}
+	walk(n)
+	return seen
+}
+
+// nodeImage is what a write to n could change: its fields, and the
+// contents of its child slices, which share their backing array with any
+// node copied from it.
+type nodeImage struct {
+	n                Node
+	children, bodies []*Node
+}
+
+func imageOf(ns map[*Node]bool) map[*Node]nodeImage {
+	out := make(map[*Node]nodeImage, len(ns))
+	for n := range ns {
+		out[n] = nodeImage{*n, slices.Clone(n.Children), slices.Clone(n.InnerHeredocBodies)}
+	}
+	return out
+}
+
+// touched is how many nodes Repair allocated, copied or wrote building
+// tree: those reachable from tree that the old tree did not hold, and
+// old's nodes whose fields or child slices differ from before.
+func touched(tree *Node, before map[*Node]nodeImage) int {
+	k := 0
+	for n := range reachable(tree) {
+		if _, ok := before[n]; !ok {
+			k++
+		}
+	}
+	for n, img := range before {
+		if !nodeFieldsEqual(n, &img.n) || !slices.Equal(n.Children, img.children) || !slices.Equal(n.InnerHeredocBodies, img.bodies) {
+			k++
+		}
+	}
+	return k
+}
+
+// nodeFieldsEqual compares a and b field by field, children by identity.
+func nodeFieldsEqual(a, b *Node) bool {
+	x, y := *a, *b
+	x.Children, y.Children, x.InnerHeredocBodies, y.InnerHeredocBodies = nil, nil, nil, nil
+	x.inc, y.inc = nil, nil
+	return TreeDiff(&x, &y) == ""
+}
+
+// TestRepairSpliceTouchesOnlyDamagedPath: for a 1-char edit in the first,
+// middle and last `sub scale` of edit5k.pl, Repair allocates, copies or
+// writes under 5% of the file's nodes. Machine-independent: it counts, it
+// does not time.
+func TestRepairSpliceTouchesOnlyDamagedPath(t *testing.T) {
+	src, _ := latencyEdit5k(t)
+	for i, e := range scaleEdits(t, []byte(src)) {
+		old := parseTracked([]byte(src), nil, "")
+		all := reachable(old)
+		before := imageOf(all)
+		tree, ok := Repair(old, e, []byte(edited(src, e)))
+		if !ok {
+			t.Fatalf("edit %d: Repair refused %+v", i, e)
+		}
+		if k, n := touched(tree, before), len(all); k*20 >= n {
+			t.Errorf("edit %d: Repair touched %d of %d nodes (%.1f%%), want under 5%%", i, k, n, 100*float64(k)/float64(n))
+		}
+	}
+}
+
+// TestRepairSharedSubtreesReadSameInOldAndNew: the statements Repair kept
+// are the old tree's own nodes, and both trees read as fresh parses of
+// their own bytes -- equal under TreeDiff, and SourceText the bytes back.
+// Ten successive repairs leave every earlier tree reading so.
+func TestRepairSharedSubtreesReadSameInOldAndNew(t *testing.T) {
+	src, _ := latencyEdit5k(t)
+	es := spliceEdits(t, []byte(src), 10)
+	trees, srcs := []*Node{parseTracked([]byte(src), nil, "")}, []string{src}
+	for k, e := range es {
+		prev := trees[len(trees)-1]
+		next := edited(srcs[len(srcs)-1], e)
+		tree, ok := Repair(prev, e, []byte(next))
+		if !ok {
+			t.Fatalf("edit %d: Repair refused %+v", k, e)
+		}
+		shared := 0
+		for _, c := range tree.Children {
+			if slices.Contains(prev.Children, c) {
+				shared++
+			}
+		}
+		if shared != len(prev.Children)-1 {
+			t.Errorf("edit %d: %d of %d top-level statements shared, want all but the anchor", k, shared, len(prev.Children))
+		}
+		trees, srcs = append(trees, tree), append(srcs, next)
+		for j, tr := range trees {
+			if d := TreeDiff(tr, Parse([]byte(srcs[j]))); d != "" {
+				t.Fatalf("after edit %d, tree %d differs from a fresh parse of its bytes: %s", k, j, d)
+			}
+			if got := tr.SourceText([]byte(srcs[j])); got != srcs[j] {
+				t.Fatalf("after edit %d, tree %d's SourceText is not its bytes", k, j)
+			}
+		}
+	}
+}
