diff --git a/internal/parse/splice_budget_test.go b/internal/parse/splice_budget_test.go
new file mode 100644
index 00000000..be91e643
--- /dev/null
+++ b/internal/parse/splice_budget_test.go
@@ -0,0 +1,58 @@
+// ABOUTME: TestRepairSpliceP99WithinBudget times Repair's splice stage over latencyEdits on edit5k.pl against 45ba's 1 ms sub-budget.
+// ABOUTME: Opt-in with PSC_LATENCY_BUDGET=1, like the psc latency gate; it logs the machine it ran on.
+package parse
+
+import (
+	"bytes"
+	"os"
+	"runtime"
+	"slices"
+	"testing"
+	"time"
+)
+
+// spliceBudget is the splice stage's sub-budget per the 01a17969-45ba
+// ruling: 1 ms unless `#### Ruling on the step-4 numbers` sets another.
+const spliceBudget = time.Millisecond
+
+// cpuModel is /proc/cpuinfo's first model name, "unknown" without one.
+func cpuModel() string {
+	b, _ := os.ReadFile("/proc/cpuinfo")
+	for _, line := range bytes.Split(b, []byte("\n")) {
+		if k, v, ok := bytes.Cut(line, []byte(":")); ok && string(bytes.TrimSpace(k)) == "model name" {
+			return string(bytes.TrimSpace(v))
+		}
+	}
+	return "unknown"
+}
+
+// TestRepairSpliceP99WithinBudget: over 200 edits of latencyEdits, the
+// splice of the reused statements around the one Repair re-parsed takes
+// under spliceBudget at p99. Timing depends on the machine, so it runs only
+// with PSC_LATENCY_BUDGET=1, on the reference 4-vCPU VM.
+func TestRepairSpliceP99WithinBudget(t *testing.T) {
+	if os.Getenv("PSC_LATENCY_BUDGET") != "1" {
+		t.Skip("timing gate: set PSC_LATENCY_BUDGET=1 to run it on the reference VM")
+	}
+	src, _ := latencyEdit5k(t)
+	tree, cur := parseTracked([]byte(src), nil, ""), []byte(src)
+	var times []time.Duration
+	for _, e := range spliceEdits(t, cur, 200) {
+		next := []byte(edited(string(cur), e))
+		t1, n, ok := repair(tree, e, next, "", func() *resolver { return nil })
+		if !ok {
+			t.Fatalf("Repair refused %+v", e)
+		}
+		i := slices.Index(t1.Children, n)
+		t0 := time.Now()
+		splice(tree, i, n, len(next)-len(cur))
+		times = append(times, time.Since(t0))
+		tree, cur = t1, next
+	}
+	slices.Sort(times)
+	p99 := times[(99*len(times)+99)/100-1]
+	t.Logf("cpu=%s nproc=%d go=%s p99=%.3fms", cpuModel(), runtime.NumCPU(), runtime.Version(), float64(p99)/float64(time.Millisecond))
+	if p99 >= spliceBudget {
+		t.Errorf("splice p99 %v, want under %v", p99, spliceBudget)
+	}
+}
